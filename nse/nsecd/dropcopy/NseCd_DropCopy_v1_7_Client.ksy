meta:
  id: nse_nsecd_dropcopy_nnfdirect_v1_7_client
  title: Nse NseCd DropCopy NnfDirect v1.7
  license: GPL-3.0
  endian: be

doc: 'National Stock Exchange of India Ltd NSE Currency Derivatives Drop Copy NnfDirect v1.7'
doc-ref: https://www.nseindia.com/static/trade/platform-services-neat-trading-system-protocols

seq:
  - id: client_direct_packet
    type: client_direct_packet_struct
    repeat: eos
    doc: 'One framed interactive message sent by the firm'

types:
  client_direct_packet_struct:
    seq:
      - id: packet_header
        type: packet_header
        doc: 'Direct interface twenty two byte packet header'
      - id: message_header
        type: message_header
        doc: 'MESSAGE_HEADER'
      - id: client_message_payload
        size: packet_header.packet_length - 62
        type:
          switch-on: message_header.transaction_code
          cases:
            'transaction_code::signon_in_message': signon_in_message
            'transaction_code::dc_download_request_message': dc_download_request_message
  packet_header:
    seq:
      - id: packet_length
        type: u2
        doc: 'Length of the entire packet including this field, capped at 1024 bytes'
      - id: packet_sequence_number
        type: u4
        doc: 'Echoed back on responses to order related requests, zero on a non encrypting connection'
      - id: checksum
        size: 16
        doc: 'Md5 digest of the message data, or the Gcm authentication tag under the new encryption'
  message_header:
    seq:
      - id: transaction_code
        type: s2
        enum: transaction_code
        doc: 'Type of message sent or received'
      - id: log_time
        type: dos_second_timestamp
        doc: 'Time the message was generated by the trading system. Seconds since Dos epoch'
      - id: alpha_char
        type: str
        size: 2
        encoding: ASCII
        pad-right: 0x20
        doc: 'First two characters of Symbol when the message carries one'
      - id: trader_id
        type: s4
        doc: 'User Id of the trader'
      - id: error_code
        type: s2
        doc: 'Zero when the request succeeded, otherwise an Error Response follows'
      - id: header_timestamp
        type: s8
        doc: 'Host end field, carrying nanoseconds since midnight 01-Jan-1980 on the transaction codes listed in the appendix'
      - id: time_stamp_1
        type: str
        size: 8
        encoding: ASCII
        pad-right: 0x20
        doc: 'Reserved for the host'
      - id: time_stamp_2
        type: str
        size: 8
        encoding: ASCII
        pad-right: 0x20
        doc: 'Time the message reached the gateway'
      - id: message_length
        type: s2
        doc: 'Length of the message including the message header, twenty two less than Packet Length'
  signon_in_message:
    seq:
      - id: user_id
        type: s4
        doc: 'User Id of the user'
      - id: reserved_8
        size: 8
        doc: 'Reserved'
      - id: password
        type: str
        size: 12
        encoding: ASCII
        pad-right: 0x20
        doc: 'Password entered by the user; alphabet, numbers and special characters are allowed'
      - id: reserved_4
        size: 4
        doc: 'Reserved'
      - id: reserved_38
        size: 38
        doc: 'Reserved'
      - id: broker_id
        type: str
        size: 5
        encoding: ASCII
        pad-right: 0x20
        doc: 'Trading member Id'
      - id: reserved_119
        size: 119
        doc: 'Reserved'
      - id: reserved_16
        size: 16
        doc: 'Reserved'
      - id: second_reserved_16
        size: 16
        doc: 'Reserved'
      - id: third_reserved_16
        size: 16
        doc: 'Reserved'
  dc_download_request_message:
    seq:
      - id: sequence_number
        type: floating_point_integer
        doc: 'Time the last message was received by the user, taken from Time Stamp 1 of the last trade confirmation; zero to retrieve from the beginning of the trading day'
  dos_second_timestamp:
    seq:
      - id: time
        type: s4
    instances:
      unix_seconds:
        value: time + 315532800
      hour:
        value: time / 3600 % 24
      minute:
        value: time / 60 % 60
      second:
        value: time % 60
  floating_point_integer:
    seq:
      - id: value
        type: f8
    instances:
      integer:
        value: value.as<s8>

enums:
  transaction_code:
    2300:
      id: 'signon_in_message'
      doc: 'Logs the user on to the drop copy feed'
    2301:
      id: 'sign_on_out_message'
      doc: 'Confirms the logon. Alpha Char carries the number of streams the drop copy feed is sent from, one download request being needed per stream. On an error the same transaction code carries the Error Response layout instead, distinguished only by a non zero Error Code'
    23506:
      id: 'heartbeat_message'
      doc: 'Keeps the connection alive during periods of inactivity. Carries the Message Header alone'
    8000:
      id: 'dc_download_request_message'
      doc: 'Requests the trade download for one stream, named in the first byte of Alpha Char, from the time given in Sequence Number'
    2222:
      id: 'trade_confirmation_message'
      doc: 'Confirms a trade'
    2282:
      id: 'trade_cancel_confirm_message'
      doc: 'Confirms the cancellation of a trade'
    2286:
      id: 'trade_cancel_reject_message'
      doc: 'Rejects a trade cancellation'
    2287:
      id: 'trade_modify_confirm_message'
      doc: 'Confirms the modification of a trade'
    2288:
      id: 'trade_modify_reject_message'
      doc: 'Rejects a trade modification'
    4506:
      id: 'giveup_app_confirm_tm_message'
      doc: 'Approves a give up'
    4507:
      id: 'giveup_rej_confirm_tm_message'
      doc: 'Rejects a give up'
  buy_sell:
    1:
      id: 'buy_order'
      doc: 'Buy Order'
    2:
      id: 'sell_order'
      doc: 'Sell Order'
  open_close:
    0x4f:
      id: 'open'
      doc: 'Open'
    0x43:
      id: 'close'
      doc: 'Close'
  book_type_short_2:
    1:
      id: 'regular_lot_order'
      doc: 'Regular Lot Order'
    2:
      id: 'special_terms_order'
      doc: 'Special Terms Order'
    3:
      id: 'stop_loss_mit_order'
      doc: 'Stop Loss Mit Order'
    4:
      id: 'negotiated_order_not_used'
      doc: 'Negotiated Order Not Used'
    5:
      id: 'odd_lot_order_not_used'
      doc: 'Odd Lot Order Not Used'
    6:
      id: 'spot_order_not_used'
      doc: 'Spot Order Not Used'
    7:
      id: 'auction_order_not_used'
      doc: 'Auction Order Not Used'

