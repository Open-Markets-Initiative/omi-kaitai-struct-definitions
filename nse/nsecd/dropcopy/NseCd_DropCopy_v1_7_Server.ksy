meta:
  id: nse_nsecd_dropcopy_nnfdirect_v1_7_server
  title: Nse NseCd DropCopy NnfDirect v1.7
  license: GPL-3.0
  endian: be

doc: 'National Stock Exchange of India Ltd NSE Currency Derivatives Drop Copy NnfDirect v1.7'
doc-ref: https://www.nseindia.com/static/trade/platform-services-neat-trading-system-protocols

seq:
  - id: server_direct_packet
    type: server_direct_packet_struct
    repeat: eos
    doc: 'One framed interactive message sent by the exchange'

types:
  server_direct_packet_struct:
    seq:
      - id: packet_header
        type: packet_header
        doc: 'Direct interface twenty two byte packet header'
      - id: message_header
        type: message_header
        doc: 'MESSAGE_HEADER'
      - id: server_message_payload
        size: packet_header.packet_length - 62
        type:
          switch-on: message_header.transaction_code
          cases:
            'transaction_code::sign_on_out_message': sign_on_out_message
            'transaction_code::trade_confirmation_message': trade_confirmation_message
            'transaction_code::trade_cancel_confirm_message': trade_cancel_confirm_message
            'transaction_code::trade_cancel_reject_message': trade_cancel_reject_message
            'transaction_code::trade_modify_confirm_message': trade_modify_confirm_message
            'transaction_code::trade_modify_reject_message': trade_modify_reject_message
            'transaction_code::giveup_app_confirm_tm_message': giveup_app_confirm_tm_message
            'transaction_code::giveup_rej_confirm_tm_message': giveup_rej_confirm_tm_message
  packet_header:
    seq:
      - id: packet_length
        type: u2
        doc: 'Length of the entire packet including this field, capped at 1024 bytes'
      - id: packet_sequence_number
        type: u4
        doc: 'Echoed back on responses to order related requests, zero on a non encrypting connection'
      - id: checksum
        size: 16
        doc: 'Md5 digest of the message data, or the Gcm authentication tag under the new encryption'
  message_header:
    seq:
      - id: transaction_code
        type: s2
        enum: transaction_code
        doc: 'Type of message sent or received'
      - id: log_time
        type: dos_second_timestamp
        doc: 'Time the message was generated by the trading system. Seconds since Dos epoch'
      - id: alpha_char
        type: str
        size: 2
        encoding: ASCII
        pad-right: 0x20
        doc: 'First two characters of Symbol when the message carries one'
      - id: trader_id
        type: s4
        doc: 'User Id of the trader'
      - id: error_code
        type: s2
        doc: 'Zero when the request succeeded, otherwise an Error Response follows'
      - id: header_timestamp
        type: s8
        doc: 'Host end field, carrying nanoseconds since midnight 01-Jan-1980 on the transaction codes listed in the appendix'
      - id: time_stamp_1
        type: str
        size: 8
        encoding: ASCII
        pad-right: 0x20
        doc: 'Reserved for the host'
      - id: time_stamp_2
        type: str
        size: 8
        encoding: ASCII
        pad-right: 0x20
        doc: 'Time the message reached the gateway'
      - id: message_length
        type: s2
        doc: 'Length of the message including the message header, twenty two less than Packet Length'
  sign_on_out_message:
    seq:
      - id: user_id
        type: s4
        doc: 'User Id of the user'
      - id: reserved_8
        size: 8
        doc: 'Reserved'
      - id: password
        type: str
        size: 12
        encoding: ASCII
        pad-right: 0x20
        doc: 'Password entered by the user; alphabet, numbers and special characters are allowed'
      - id: reserved_4
        size: 4
        doc: 'Reserved'
      - id: reserved_38
        size: 38
        doc: 'Reserved'
      - id: broker_id
        type: str
        size: 5
        encoding: ASCII
        pad-right: 0x20
        doc: 'Trading member Id'
      - id: reserved_119
        size: 119
        doc: 'Reserved'
      - id: reserved_16
        size: 16
        doc: 'Reserved'
      - id: second_reserved_16
        size: 16
        doc: 'Reserved'
      - id: third_reserved_16
        size: 16
        doc: 'Reserved'
  trade_confirmation_message:
    seq:
      - id: response_order_number
        type: floating_point_integer
        doc: 'Order number of the order taking part in the trade'
      - id: broker_id
        type: str
        size: 5
        encoding: ASCII
        pad-right: 0x20
        doc: 'Trading member Id'
      - id: reserved_1
        size: 1
        doc: 'Reserved'
      - id: trader_num
        type: s4
        doc: 'Trader or user Id'
      - id: account_num
        type: str
        size: 10
        encoding: ASCII
        pad-right: 0x20
        doc: 'Account number or client code'
      - id: buy_sell
        type: s2
        enum: buy_sell
        doc: 'Whether the order taking part is a buy or a sell'
      - id: original_vol
        type: s4
        doc: 'Original traded volume'
      - id: disclosed_vol
        type: s4
        doc: 'Quantity disclosed to the market'
      - id: remaining_vol
        type: s4
        doc: 'Volume remaining after the trade'
      - id: disclosed_vol_remaining
        type: s4
        doc: 'Disclosed volume remaining after the trade'
      - id: price
        type: decimal_s4_7
        doc: 'Order price. Implied decimal with scale 1e-7'
      - id: st_order_flags
        type: st_order_flags
        doc: 'Terms attached to the order'
      - id: gtd
        type: s4
        doc: 'Number of days for a GTD order'
      - id: fill_number
        type: s4
        doc: 'Trade number'
      - id: fill_qty
        type: s4
        doc: 'Traded volume'
      - id: fill_price
        type: decimal_s4_7
        doc: 'Price at which the order traded, to be divided by 10000000 to get the price in rupees. Implied decimal with scale 1e-7'
      - id: vol_filled_today
        type: s4
        doc: 'Quantity traded today'
      - id: activity_type
        type: str
        size: 2
        encoding: ASCII
        pad-right: 0x20
        doc: 'Type of activity being confirmed'
      - id: activity_time
        type: dos_second_timestamp
        doc: 'Time the activity occurred. Seconds since Dos epoch'
      - id: op_order_number
        type: floating_point_integer
        doc: 'Order number on the counter party side'
      - id: op_broker_id
        type: str
        size: 5
        encoding: ASCII
        pad-right: 0x20
        doc: 'Trading member Id of the counter party'
      - id: second_reserved_1
        size: 1
        doc: 'Reserved'
      - id: token
        type: s4
        doc: 'Token number of the contract'
      - id: contract_desc
        type: contract_desc
        doc: 'CONTRACT_DESC'
      - id: open_close
        type: u1
        enum: open_close
        doc: 'Whether the trade opens or closes a position'
      - id: old_open_close
        type: str
        size: 1
        encoding: ASCII
        pad-right: 0x20
        doc: 'Previous open or close indicator'
      - id: book_type_char_1
        type: str
        size: 1
        encoding: ASCII
        pad-right: 0x20
        doc: 'Book the order belongs to'
      - id: third_reserved_1
        size: 1
        doc: 'Reserved'
      - id: new_volume
        type: s4
        doc: 'Revised volume'
      - id: old_account_number
        type: str
        size: 10
        encoding: ASCII
        pad-right: 0x20
        doc: 'Previous account number'
      - id: participant
        type: str
        size: 12
        encoding: ASCII
        pad-right: 0x20
        doc: 'Participant''s name'
      - id: old_participant
        type: str
        size: 12
        encoding: ASCII
        pad-right: 0x20
        doc: 'Previous participant''s name'
      - id: additional_order_flags
        type: additional_order_flags
        doc: 'Further terms attached to the order'
      - id: fourth_reserved_1
        size: 1
        doc: 'Reserved'
      - id: give_up_trade
        type: str
        size: 1
        encoding: ASCII
        pad-right: 0x20
        doc: 'Whether the trade is a give up'
      - id: fifth_reserved_1
        size: 1
        doc: 'Reserved'
      - id: pan
        type: str
        size: 10
        encoding: ASCII
        pad-right: 0x20
        doc: 'Permanent Account Number'
      - id: old_pan
        type: str
        size: 10
        encoding: ASCII
        pad-right: 0x20
        doc: 'Previous Permanent Account Number'
      - id: algo_id
        type: s4
        doc: 'Algo Id issued by the exchange, zero for a non algo order'
      - id: algo_category
        type: s2
        doc: 'Algo category'
      - id: last_activity_reference
        type: s8
        doc: 'Unique value for the activity, currently in nanoseconds'
      - id: nnf_field
        type: floating_point_integer
        doc: 'Fifteen digit unique identifier for the product'
      - id: reserved_44
        size: 44
        doc: 'Reserved'
  st_order_flags:
    seq:
      - id: ato
        type: b1
        doc: 'At the opening order'
      - id: market
        type: b1
        doc: 'Market order'
      - id: sl
        type: b1
        doc: 'Stop loss order'
      - id: mit
        type: b1
        doc: 'Market if touched order'
      - id: day
        type: b1
        doc: 'Day order'
      - id: gtc
        type: b1
        doc: 'Good till cancelled order'
      - id: ioc
        type: b1
        doc: 'Immediate or cancel order'
      - id: aon
        type: b1
        doc: 'All or none order'
      - id: mf
        type: b1
        doc: 'Minimum fill order'
      - id: matched_ind
        type: b1
        doc: 'Order has been matched'
      - id: traded
        type: b1
        doc: 'Order has traded'
      - id: modified
        type: b1
        doc: 'Order has been modified'
      - id: frozen
        type: b1
        doc: 'Order is frozen for Nse Control to release'
      - id: reserved_13
        type: b3
        doc: 'Reserved'
  contract_desc:
    seq:
      - id: instrument_name
        type: str
        size: 6
        encoding: ASCII
        pad-right: 0x20
        doc: 'Instrument name of the contract'
      - id: symbol
        type: str
        size: 10
        encoding: ASCII
        pad-right: 0x20
        doc: 'Symbol of the underlying'
      - id: expiry_date
        type: dos_second_timestamp
        doc: 'Expiry date of the contract. Seconds since Dos epoch'
      - id: strike_price
        type: decimal_s4_7_nullable
        doc: 'Valid strike for an options contract, and -1 for a futures contract. Implied decimal with scale 1e-7. Nullable, Futures Contract = -1'
      - id: option_type
        type: str
        size: 2
        encoding: ASCII
        pad-right: 0x20
        doc: 'Option type identifier'
      - id: ca_level
        type: s2
        doc: 'Corporate action level'
  additional_order_flags:
    meta:
      bit-endian: le
    seq:
      - id: additional_order_flags_reserved_1
        type: b1
        doc: 'Reserved'
      - id: col
        type: b1
        doc: 'Collateral order'
      - id: additional_order_flags_reserved_38
        type: b6
        doc: 'Reserved'
  trade_cancel_confirm_message:
    seq:
      - id: response_order_number
        type: floating_point_integer
        doc: 'Order number of the order taking part in the trade'
      - id: broker_id
        type: str
