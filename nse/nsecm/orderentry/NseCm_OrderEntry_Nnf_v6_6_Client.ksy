meta:
  id: nse_nsecm_orderentry_nnf_v6_6_client
  title: Nse NseCm OrderEntry Nnf v6.6
  license: GPL-3.0
  endian: be

doc: 'National Stock Exchange of India Ltd NSE Capital Market Order Entry Nnf v6.6'
doc-ref: https://www.nseindia.com/static/trade/platform-services-neat-trading-system-protocols

seq:
  - id: client_message
    type: client_message_struct
    repeat: eos
    doc: 'Nnf interactive message sent by the firm'

types:
  client_message_struct:
    seq:
      - id: message_header
        type: message_header
        doc: 'MESSAGE_HEADER'
      - id: client_message_payload
        size: message_header.message_length - 40
        type:
          switch-on: message_header.transaction_code
          cases:
            'transaction_code::branch_order_value_limit_update_in_message': branch_order_value_limit_update_in_message
            'transaction_code::cancel_on_logout_status_request_message': cancel_on_logout_status_request_message
            'transaction_code::message_download_request_message': message_download_request_message
            'transaction_code::auction_inquiry_request_message': auction_inquiry_request_message
            'transaction_code::box_sign_off_message': box_sign_off_message
            'transaction_code::box_sign_on_request_message': box_sign_on_request_message
            'transaction_code::gateway_router_request_message': gateway_router_request_message
            'transaction_code::order_entry_in_message': order_entry_in_message
            'transaction_code::order_entry_in_message_2040': order_entry_in_message
            'transaction_code::order_entry_in_message_2062': order_entry_in_message
            'transaction_code::order_entry_in_message_2070': order_entry_in_message
            'transaction_code::order_limit_update_in_message': order_limit_update_in_message
            'transaction_code::password_reset_in_message': password_reset_in_message
            'transaction_code::sign_on_request_in_message': sign_on_request_in_message
            'transaction_code::sign_on_request_in_message_5723': sign_on_request_in_message
            'transaction_code::trade_inquiry_in_message': trade_inquiry_in_message
            'transaction_code::trade_inquiry_in_message_5445': trade_inquiry_in_message
            'transaction_code::update_local_database_request_message': update_local_database_request_message
            'transaction_code::trade_modification_cancellation_status_request_message': trade_modification_cancellation_status_request_message
            'transaction_code::user_unlock_request_message': user_unlock_request_message
            'transaction_code::user_order_value_limit_update_in_message': user_order_value_limit_update_in_message
  message_header:
    seq:
      - id: transaction_code
        type: s2
        enum: transaction_code
        doc: 'Type of message sent or received'
      - id: log_time
        type: dos_second_timestamp
        doc: 'Time the message was generated by the trading system. Seconds since Dos epoch'
      - id: alpha_char
        type: str
        size: 2
        encoding: ASCII
        pad-right: 0x20
        doc: 'First two characters of Symbol when the message carries one'
      - id: trader_id
        type: s4
        doc: 'This field should contain the user ID'
      - id: error_code
        type: s2
        doc: 'Zero when the request succeeded, otherwise an Error Response follows'
      - id: header_timestamp
        type: s8
        doc: 'Host end field, carrying nanoseconds since midnight 01-Jan-1980 on the transaction codes listed in the appendix'
      - id: time_stamp_1
        type: str
        size: 8
        encoding: ASCII
        pad-right: 0x20
        doc: 'Reserved for the host'
      - id: time_stamp_2
        type: str
        size: 8
        encoding: ASCII
        pad-right: 0x20
        doc: 'Time the message reached the gateway'
      - id: message_length
        type: s2
        doc: 'Length of the entire message including the message header'
  branch_order_value_limit_update_in_message:
    seq:
      - id: broker_id
        type: str
        size: 5
        encoding: ASCII
        pad-right: 0x20
        doc: 'This field should contain the trading member ID'
      - id: reserved_25
        size: 25
        doc: 'Reserved for future use 172 173'
      - id: branch
        type: s2
        doc: 'This field should contain the branch number for which limit to be set This field should contain the branch number of user for which limit to be set 7'
      - id: branch_limit
        type: branch_limit
        doc: 'BRANCH_LIMIT'
  branch_limit:
    seq:
      - id: branch_buy_value_limit
        type: floating_point_integer
        doc: 'Buy value limit set for the branch'
      - id: reserved_8
        size: 8
        doc: 'Reserved for future use 172 173'
      - id: branch_sell_value_limit
        type: floating_point_integer
        doc: 'Sell value limit set for the branch'
      - id: second_reserved_8
        size: 8
        doc: 'Reserved for future use 172 173'
  cancel_on_logout_status_request_message:
    seq:
      - id: user_id
        type: s4
        doc: 'This field should contain User ID of user/broker'
      - id: colo_user_bit
        type: str
        size: 1
        encoding: ASCII
        pad-right: 0x20
        doc: 'This field should contain user’s COL status to be set'
      - id: reserved_7
        size: 7
        doc: 'Reserved for future use 172 173'
  message_download_request_message:
    seq:
      - id: sequence_number
        type: floating_point_integer
        doc: 'This field should be set to numerical zero while sending the request to host'
  auction_inquiry_request_message:
    seq:
      - id: sec_info
        type: sec_info
        doc: 'SEC_INFO'
      - id: auction_no
        type: s2
        doc: 'This field should contain the auction number'
      - id: page_indicator
        type: str
        size: 1
        encoding: ASCII
        pad-right: 0x20
        doc: 'This field is to help the user browse through various pages of information'
      - id: filler
        type: str
        size: 1
        encoding: ASCII
        pad-right: 0x20
        doc: 'Filler'
  sec_info:
    seq:
      - id: symbol
        type: str
        size: 10
        encoding: ASCII
        pad-right: 0x20
        doc: 'Symbol of the security'
      - id: series
        type: str
        size: 2
        encoding: ASCII
        pad-right: 0x20
        doc: 'Series of the security'
  box_sign_off_message:
    seq:
      - id: box_id
        type: s2
        doc: 'Exchange provided Box ID to be used for this connection 165 SECURE_BOX_REGISTRATION_RESPONSE Exchange provided Box ID to be used for this connection 166 Exchange provided Box ID used for this connection Exchange provided Box ID used for this connection 170'
  box_sign_on_request_message:
    seq:
      - id: box_id
        type: s2
        doc: 'Exchange provided Box ID to be used for this connection 165 SECURE_BOX_REGISTRATION_RESPONSE Exchange provided Box ID to be used for this connection 166 Exchange provided Box ID used for this connection Exchange provided Box ID used for this connection 170'
      - id: broker_id
        type: str
        size: 5
        encoding: ASCII
        pad-right: 0x20
        doc: 'This field should contain the trading member ID'
      - id: reserved_5
        size: 5
        doc: 'Reserved for future use 172 173'
      - id: session_key
        type: str
        size: 8
        encoding: ASCII
        pad-right: 0x20
        doc: 'Session key received in GR_RESPONSE(2401) MS_BOX_SIGN_ON_REQUEST_OUT'
  gateway_router_request_message:
    seq:
      - id: box_id
        type: s2
        doc: 'Exchange provided Box ID to be used for this connection 165 SECURE_BOX_REGISTRATION_RESPONSE Exchange provided Box ID to be used for this connection 166 Exchange provided Box ID used for this connection Exchange provided Box ID used for this connection 170'
      - id: broker_id
        type: str
        size: 5
        encoding: ASCII
        pad-right: 0x20
        doc: 'This field should contain the trading member ID'
      - id: filler
        type: str
        size: 1
        encoding: ASCII
        pad-right: 0x20
        doc: 'Filler'
  order_entry_in_message:
    seq:
      - id: participant_type
        type: str
        size: 1
        encoding: ASCII
        pad-right: 0x20
        doc: 'Since only exchange can initiate the auction, this field should not be set to ‘I’ for initiator'
      - id: reserved_1
        size: 1
        doc: 'Reserved for future use 172 173'
      - id: competitor_period
        type: s2
        doc: 'This field contains the default competitor period for auction'
      - id: solicitor_period
        type: s2
        doc: 'This field contains the default solicitor period for auction'
      - id: mod_cxl_by
        type: str
        size: 1
        encoding: ASCII
        pad-right: 0x20
        doc: 'This field denotes which person has modified or cancelled a particular order'
      - id: filler_9
        type: str
        size: 1
        encoding: ASCII
        pad-right: 0x20
        doc: 'Filler'
      - id: reason_code
        type: s2
        doc: 'This field contains the reason code for a particular order request rejection or order being frozen'
      - id: reserved_4
        size: 4
        doc: 'Reserved for future use 172 173'
      - id: sec_info
        type: sec_info
        doc: 'SEC_INFO'
      - id: auction_number
        type: s2
        doc: 'Auction number is available when initiation of auction is broadcast (Auction Status Change Broadcast)'
      - id: op_broker_id
        type: str
        size: 5
        encoding: ASCII
        pad-right: 0x20
        doc: 'This field will always be blank'
      - id: suspended
        type: str
        size: 1
        encoding: ASCII
        pad-right: 0x20
        doc: 'This field specifies whether the security is suspended or not'
      - id: order_number
        type: floating_point_integer
        doc: 'This field contains an Order Number assigned to the order'
      - id: account_number
        type: str
        size: 10
        encoding: ASCII
        pad-right: 0x20
        doc: 'If the order is entered on behalf of a trader, the trader account number should be specified in this field'
      - id: book_type
        type: s2
        enum: book_type
        doc: 'This field should contain the type of order'
      - id: buy_sell
        type: s2
        doc: 'This field should specify whether the order is a buy or sell'
      - id: disclosed_vol
        type: s4
        doc: 'This field should specify the quantity that has to be disclosed to the market'
      - id: disclosed_vol_remaining
        type: s4
        doc: 'This field contains the disclosed volume remaining from the original disclosed volume after trade(s)'
      - id: total_vol_remaining
        type: s4
        doc: 'This field specifies the total quantity remaining from the original quantity after trade(s)'
      - id: volume
        type: s4
        doc: 'This field should specify the quantity of the order placed'
      - id: volume_filled_today
        type: s4
        doc: 'This field contains the total quantity traded in a day'
      - id: price
        type: decimal_s4_2
        doc: 'This field should contain the price at which the order is placed. Implied decimal with scale 1e-2'
      - id: trigger_price
        type: decimal_s4_2
        doc: 'This field is applicable only for a Stop Loss order and should be a multiple of the tick size. Implied decimal with scale 1e-2'
      - id: good_till_date
        type: s4
        doc: 'This field should contain the number of days for a GTD order'
      - id: entry_date_time
        type: dos_second_timestamp
        doc: 'This field should be set to zero while sending the order entry request. Seconds since Dos epoch'
      - id: min_fill_aon
        type: s4
        doc: 'Min Fill Aon'
      - id: last_modified
        type: dos_second_timestamp
        doc: 'If the order has been modified, this field contains the time when the order was last modified. Seconds since Dos epoch'
      - id: st_order_flags
        type: st_order_flags
        doc: 'Flags packed into 2 bytes'
      - id: branch_id
        type: s2
        doc: 'This field should contain the Branch ID to which the broker belongs'
      - id: trader_id
        type: s4
        doc: 'This field should contain the user ID'
      - id: broker_id
        type: str
        size: 5
        encoding: ASCII
        pad-right: 0x20
        doc: 'This field should contain the trading member ID'
      - id: oe_remarks
        type: str
        size: 25
        encoding: ASCII
        pad-right: 0x20
        doc: 'This field may contain any remarks that the dealer can enter about the order in this field'
      - id: settlor
        type: str
        size: 12
        encoding: ASCII
        pad-right: 0x20
        doc: 'This field contains the ID of the participants who are responsible for settling the trades through the custodians'
      - id: pro_client
        type: s2
        doc: 'This field should contain one of the following values based on the order entering is on behalf of the broker or a trader'
      - id: settlement_type
        type: s2
        doc: 'This field contains the settlement type'
      - id: nnf_field
        type: floating_point_integer
        doc: 'This field should contain a 15 digit a unique identifier for various products deployed as per Exchange circular download ref no'
      - id: exec_time_stamp
        type: floating_point_integer
        doc: 'This field is used to store the time of writing to the order book'
      - id: second_reserved_4
        size: 4
        doc: 'Reserved for future use 172 173'
      - id: pan
        type: str
        size: 10
        encoding: ASCII
        pad-right: 0x20
        doc: 'This field shall contain the PAN (Permanent Account Number / PAN_EXEMPT) - This field shall be mandatory for all orders (client / participant / PRO orders)'
      - id: algo_id
        type: s4
        doc: 'For Algo order this field shall contain the Algo ID issued by the exchange'
      - id: reserved_2
        size: 2
        doc: 'This field is reserved for future use'
      - id: last_activity_reference
        type: s8
        doc: 'This field should be set to zero while sending the order entry request'
      - id: reserved_52
        size: 52
        doc: 'Reserved for future use 172 173'
  st_order_flags:
    seq:
      - id: ato
        type: b1
        doc: 'At the open order'
      - id: mkt
        type: b1
        doc: 'Market order'
      - id: on_stop
        type: b1
        doc: 'Stop loss order'
      - id: day
        type: b1
        doc: 'Day order'
      - id: gtc
        type: b1
        doc: 'Good till cancelled order'
      - id: ioc
        type: b1
        doc: 'Immediate or cancel order'
      - id: aon
        type: b1
        doc: 'All or none order'
      - id: mf
        type: b1
        doc: 'Minimum fill order'
      - id: matched_ind
        type: b1
        doc: 'Order has been matched'
      - id: traded
        type: b1
        doc: 'Order has traded at least partly'
      - id: modified
        type: b1
        doc: 'Order has been modified'
      - id: frozen
        type: b1
        doc: 'Order has resulted in a freeze awaiting approval'
      - id: preopen
        type: b1
        doc: 'Order belongs to the pre open session'
      - id: order_flags_reserved_three
        type: b1
        doc: 'Reserved'
      - id: stpc
        type: b1
        doc: 'Self trade prevention check'
      - id: order_flags_reserved_one
        type: b1
        doc: 'Reserved'
  order_limit_update_in_message:
    seq:
      - id: broker_id
        type: str
        size: 5
        encoding: ASCII
        pad-right: 0x20
        doc: 'This field should contain the trading member ID'
      - id: reserved_1
        size: 1
        doc: 'Reserved for future use 172 173'
      - id: user_id
        type: s4
        doc: 'This field should contain User ID of user/broker'
      - id: order_qty_limit
        type: floating_point_integer
        doc: 'Order Qty Limit'
      - id: order_val_limit
        type: floating_point_integer
        doc: 'This field should contain Order Limit to be Set in lakhs Valid values: 0 to 9999999.99 This is to be multiplied by (100000*100) before sending to the trading system host 178'
      - id: reserved_2
        size: 2
        doc: 'This field is reserved for future use'
  password_reset_in_message:
    seq:
      - id: user_id
        type: s4
        doc: 'This field should contain User ID of user/broker'
      - id: reserved_14
        size: 14
        doc: 'Reserved for future use 172 173'
  sign_on_request_in_message:
    seq:
      - id: user_id
        type: s4
        doc: 'This field should contain User ID of user/broker'
      - id: reserved_8
        size: 8
        doc: 'Reserved for future use 172 173'
      - id: password
        type: str
        size: 8
        encoding: ASCII
        pad-right: 0x20
        doc: 'This field should contain the password entered by the user'
      - id: second_reserved_8
        size: 8
        doc: 'Reserved for future use 172 173'
      - id: new_password
        type: str
        size: 8
        encoding: ASCII
        pad-right: 0x20
        doc: 'This field should contain the new password entered by the user'
      - id: trader_name
        type: str
        size: 26
        encoding: ASCII
        pad-right: 0x20
        doc: 'This field when received from the host contains the user’s name'
      - id: last_password_change_date_time
        type: dos_second_timestamp
        doc: 'Last Password Change Date Time. Seconds since Dos epoch'
      - id: broker_id
        type: str
        size: 5
        encoding: ASCII
        pad-right: 0x20
        doc: 'This field should contain the trading member ID'
      - id: reserved_1
        size: 1
        doc: 'Reserved for future use 172 173'
      - id: branch_id
        type: s2
        doc: 'This field should contain the Branch ID to which the broker belongs'
      - id: version_number
        type: s4
        doc: 'This field should contain the version number of the trading system'
      - id: reserved_56
        size: 56
        doc: 'Reserved for future use 172 173'
      - id: user_type
        type: s2
        doc: 'This field indicates the type of user'
      - id: sequence_number
        type: floating_point_integer
        doc: 'This field should be set to numerical zero while sending the request to host'
      - id: workstation_number
        type: str
        size: 14
        encoding: ASCII
        pad-right: 0x20
        doc: 'Workstation Number'
      - id: broker_status
        type: str
        size: 1
        encoding: ASCII
        pad-right: 0x20
        doc: 'This field should be set to blank'
      - id: show_index
        type: str
        size: 1
        encoding: ASCII
        pad-right: 0x20
        doc: '‘T’ = to use Trimmed-NNF protocol with Total Traded Quantity and Value Data Type Change Note: Only Trimmed-NNF protocol is supported by Direct Interface 167 HEARTBEAT'
      - id: broker_eligibility_per_market
        type: broker_eligibility_per_market
        doc: 'Flags packed into 2 bytes'
      - id: broker_name
        type: str
        size: 26
        encoding: ASCII
        pad-right: 0x20
        doc: 'This field should be set to blank This field contains the broker’s name (trading member name)'
      - id: reserved_16
        size: 16
        doc: 'Reserved for future use 172 173'
      - id: second_reserved_16
        size: 16
        doc: 'Reserved for future use 172 173'
      - id: third_reserved_16
        size: 16
        doc: 'Reserved for future use 172 173'
  broker_eligibility_per_market:
    seq:
      - id: normal_market
        type: b1
        doc: 'Broker is eligible to trade in the normal market'
      - id: oddlot_market
        type: b1
        doc: 'Broker is eligible to trade in the odd lot market'
      - id: spot_market
        type: b1
        doc: 'Broker is eligible to trade in the spot market'
      - id: auction_market
        type: b1
        doc: 'Broker is eligible to trade in the auction market'
      - id: call_auction_11
        type: b1
        doc: 'Broker is eligible to trade in the first call auction market'
      - id: call_auction_21
        type: b1
        doc: 'Broker is eligible to trade in the second call auction market'
      - id: broker_eligibility_reserved_lower
        type: b2
        doc: 'Reserved'
      - id: broker_eligibility_reserved_upper
        type: b7
        doc: 'Reserved'
      - id: preopen
        type: b1
        doc: 'Order belongs to the pre open session'
  trade_inquiry_in_message:
    seq:
      - id: sec_info
        type: sec_info
        doc: 'SEC_INFO'
      - id: fill_number
        type: s4
        doc: 'This field should contain the trade number of the trade to be modified'
      - id: fill_qty
        type: s4
        doc: 'This field contains the traded volume'
      - id: fill_price
        type: decimal_s4_2
        doc: 'This field should contain the price at which the trade took place. Implied decimal with scale 1e-2'
      - id: market_type
        type: s2
        enum: market_type
        doc: 'This field should contain the value to denote the type of market, • ‘1’ for Normal Market'
      - id: new_volume
        type: s4
        doc: 'This field value should be same as that of FillQuantity'
      - id: reserved_24
        size: 24
        doc: 'Reserved for future use 172 173'
      - id: buy_broker_id
        type: str
        size: 5
        encoding: ASCII
        pad-right: 0x20
        doc: 'Buy Broker Id'
      - id: sell_broker_id
        type: str
        size: 5
        encoding: ASCII
        pad-right: 0x20
        doc: 'Sell Broker Id'
      - id: trader_id
        type: s4
        doc: 'This field should contain the user ID'
      - id: requested_by
        type: s2
        doc: 'This field indicates which side (Buy/Sell) of the trade is to be modified/cancelled'
      - id: buy_account_number
        type: str
        size: 10
        encoding: ASCII
        pad-right: 0x20
        doc: 'This field should contain the Account Number of the trade on Buy side'
      - id: sell_account_number
        type: str
        size: 10
        encoding: ASCII
        pad-right: 0x20
        doc: 'This field should contain the Account Number of the trade on Sell side'
      - id: buy_pan
        type: str
        size: 10
        encoding: ASCII
        pad-right: 0x20
        doc: 'This field shall contain the PAN (Permanent Account Number/PAN_EXEMPT)'
      - id: sell_pan
        type: str
        size: 10
        encoding: ASCII
        pad-right: 0x20
        doc: 'This field shall contain the PAN (Permanent Account Number/PAN_EXEMPT)'
      - id: reserved_60
        size: 60
        doc: 'Reserved for future use 172 173'
  update_local_database_request_message:
    seq:
      - id: last_update_security_time
        type: dos_second_timestamp
        doc: 'This field should contain the time when the security information was last updated. Seconds since Dos epoch'
      - id: last_update_participant_time
        type: dos_second_timestamp
        doc: 'Last Update Participant Time. Seconds since Dos epoch'
      - id: request_for_open_orders
        type: str
        size: 1
        encoding: ASCII
        pad-right: 0x20
        doc: 'This field should be set to ‘G’ if GTC and GTD orders are to be downloaded'
      - id: reserved_1
        size: 1
        doc: 'Reserved for future use 172 173'
      - id: normal_market_status
        type: s2
        doc: 'This field should contain the latest Normal Market status available at TWS'
      - id: odd_lot_market_status
        type: s2
        doc: 'This field should contain the latest Odd Lot Market status available at TWS'
      - id: spot_market_status
        type: s2
        doc: 'This field should contain the latest Spot Market status available at TWS'
      - id: auction_market_status
        type: s2
        doc: 'This field should contain the latest Auction Market status available at TWS'
      - id: call_auction_1_market_status
        type: s2
        doc: 'Call Auction1 Market Status'
      - id: call_auction_2_market_status
        type: s2
        doc: 'Call Auction2 Market Status'
  trade_modification_cancellation_status_request_message:
    seq:
      - id: user_id
        type: s4
        doc: 'This field should contain User ID of user/broker'
      - id: trd_mod_cxl_bit
        type: str
        size: 1
        encoding: ASCII
        pad-right: 0x20
        doc: 'This field should contain user’s Trade Cancellation Status to be set'
      - id: reserved_7
        size: 7
        doc: 'Reserved for future use 172 173'
  user_unlock_request_message:
    seq:
      - id: user_id
        type: s4
        doc: 'This field should contain User ID of user/broker'
      - id: reserved_24
        size: 24
        doc: 'Reserved for future use 172 173'
  user_order_value_limit_update_in_message:
    seq:
      - id: broker_id
        type: str
        size: 5
        encoding: ASCII
        pad-right: 0x20
        doc: 'This field should contain the trading member ID'
      - id: reserved_1
        size: 1
        doc: 'Reserved for future use 172 173'
      - id: branch
        type: s2
        doc: 'This field should contain the branch number for which limit to be set This field should contain the branch number of user for which limit to be set 7'
      - id: reserved_26
        size: 26
        doc: 'Reserved for future use 172 173'
      - id: user_id
        type: s4
        doc: 'This field should contain User ID of user/broker'
      - id: user_limits
        type: user_limits
        doc: 'USER_LIMITS'
  user_limits:
    seq:
      - id: reserved_16
        size: 16
        doc: 'Reserved for future use 172 173'
      - id: user_order_buy_value_limit
        type: floating_point_integer
        doc: 'Buy value limit set for the user'
      - id: reserved_24
        size: 24
        doc: 'Reserved for future use 172 173'
      - id: user_order_sell_value_limit
        type: floating_point_integer
        doc: 'Sell value limit set for the user'
      - id: reserved_8
        size: 8
        doc: 'Reserved for future use 172 173'
  dos_second_timestamp:
    seq:
      - id: time
        type: s4
    instances:
      unix_seconds:
        value: time + 315532800
      hour:
        value: time / 3600 % 24
      minute:
        value: time / 60 % 60
      second:
        value: time % 60
  floating_point_integer:
    seq:
      - id: value
        type: f8
    instances:
      integer:
        value: value.as<s8>
  decimal_s4_2:
    seq:
      - id: mantissa
        type: s4
    instances:
      real:
        value: mantissa / 100.0

