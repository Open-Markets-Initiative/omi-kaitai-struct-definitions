# ---------------------------------------------------------------------
# Kaitai struct definition for: Miax EmeraldOptions ClearingTradeDrop Ctd v1.2.c
#
# Protocol:
#   Organization: Miami International Holdings
#   Protocol: Clearing Trade Drop
#   Encoding: Miax Clearing Trade Drop
#   Version: 1.2.c
#   Date: 07/12/2023
#   Specification: Clearing Trade Drop CTD v1.2c.pdf
#
# Script:
#   Generator: 1.0.0.0
#   License: MIT No Attribution
#   Authors: Omi Developers
