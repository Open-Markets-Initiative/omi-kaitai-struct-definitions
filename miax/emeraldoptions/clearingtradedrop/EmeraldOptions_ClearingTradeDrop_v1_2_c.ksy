#   https://openmarketsinitiative.com
# ---------------------------------------------------------------------

meta:
  id: miax_emeraldoptions_clearingtradedrop_ctd_v1_2_c
  title: Miax EmeraldOptions ClearingTradeDrop Ctd v1.2.c
  license: MIT-0
  endian: le

doc: 'Miami International Holdings MIAX Emerald Options Clearing Trade Drop Ctd v1.2.c'
doc-ref: https://www.miaxglobal.com/markets/us-options/emerald-options/interface-specifications

seq:
  - id: sesm_tcp_packet
    type: sesm_tcp_packet_struct
    repeat: eos
    doc: 'SesM Tcp Packet'

types:
  sesm_tcp_packet_struct:
    seq:
      - id: sesm_packet_header
        type: sesm_packet_header
        doc: 'SesM packet header'
      - id: sesm_payload
        size: sesm_packet_header.sesm_packet_length + 2 - 3
        type:
          switch-on: sesm_packet_header.sesm_packet_type
          cases:
            'sesm_packet_type::sequenced_data_packet': sequenced_data_packet
            'sesm_packet_type::unsequenced_data_packet': unsequenced_data_packet
            'sesm_packet_type::login_request': login_request
            'sesm_packet_type::login_response': login_response
            'sesm_packet_type::retransmission_request': retransmission_request
            'sesm_packet_type::logout_request': logout_request
            'sesm_packet_type::goodbye_packet': goodbye_packet
            'sesm_packet_type::test_packet': test_packet
  sesm_packet_header:
    seq:
      - id: sesm_packet_length
        type: u2
        doc: 'The length of rest of the packet'
      - id: sesm_packet_type
        type: u1
        enum: sesm_packet_type
        doc: 'SesM protocol packet type'
  sequenced_data_packet:
    seq:
      - id: sequence_number
        type: u8
        doc: 'Sequence number of this sequenced data packet'
      - id: sequenced_message_type
        type: u1
        enum: sequenced_message_type
        doc: 'Message type of the application message the sequenced data packet carries'
      - id: sequenced_message
        size: _parent.sesm_packet_header.sesm_packet_length - 1 - 9
        type:
          switch-on: sequenced_message_type
          cases:
            'sequenced_message_type::system_state': system_state
            'sequenced_message_type::trade_message': trade_message
            'sequenced_message_type::risk_notification_message': risk_notification_message
  system_state:
    seq:
      - id: notification_time
        type: nanosecond_timestamp
        doc: 'Time at which this was generated by Emerald system. Nanoseconds since Midnight epoch'
      - id: ctd_version
        type: str
        size: 8
        encoding: ASCII
        pad-right: 0x20
        doc: 'E.g.: CTD1.0. Firm are advised to send the CTD Version number indicated on the cover page this document'
      - id: trading_session_id
        type: u4
        doc: 'Emerald assigned ID for the current trading session. A change in Session ID will mean that restarting at message sequence number 1'
      - id: system_status
        type: u1
        enum: system_status
        doc: 'Current system status'
  trade_message:
    seq:
      - id: processing_time
        type: nanosecond_timestamp
        doc: 'Time at which Emerald system (Matching Engine) processed this trade. Nanoseconds since Midnight epoch'
      - id: trade_time
        type: nanosecond_timestamp
        doc: 'Automatic Trades: Time at which the Matching Engine created this trade. Will be same as Processing Time. Manual Trades: Trade Time of the new manual trade. Trades cancels, corrections: Trade Time of the original trade. Nanoseconds since Midnight epoch'
      - id: trade_as_of_date
        type: u4
        doc: 'As-of Date for As-of Trades. Format: YYYYMMDD. Zero for non As-of Trades'
      - id: trade_action
        type: u1
        enum: trade_action
        doc: 'Note that New trades and Trade Cancel messages can also be generated due to a Clearing changing correction. See Correction Type field for details'
      - id: trade_type
        type: u1
        enum: trade_type
        doc: 'Trade Type'
      - id: trade_id
        type: u4
        doc: 'Emerald- assigned unique Trade ID for the day. For corrections and cancels, this is the trade ID of the original trade. When used in conjunction with Correction Number, Side and Trade Action, this is a unique identifier for each clearing trade'
      - id: execution_id
        type: u8
        doc: 'Emerald- assigned unique Execution ID. Each side of the Clearing trade will have a unique Execution ID'
      - id: correction_number
        type: u1
        doc: 'Trade correction number. Used to identify version of the trade being corrected or canceled. Increments by 1 for each subsequent correction. While this is 0 for new trades, new trades resulting from corrections may have a non-zero number'
      - id: transaction_id
        type: u4
        doc: 'All clearing trades generated from a single Engine transaction will have the same transaction ID'
      - id: reference_trade_time
        type: nanosecond_timestamp
        doc: 'Time of the parent trade (version of this trade that was active prior to this correction) in case of a correction or a new trade generated due to correction. 0 otherwise. Nanoseconds since Midnight epoch'
      - id: reference_trade_id
        type: u4
        doc: 'Trade ID of the parent trade in case of a correction or a new trade generated due to correction. 0 otherwise'
      - id: reference_correction_number
        type: u1
        doc: 'Correction Number of the parent trade in case of a correction or a new trade generated due to correction. 0 otherwise'
      - id: correction_type
        type: u1
        enum: correction_type
        doc: 'Gives more information to the user when this is a correction'
      - id: event_id
        type: u4
        doc: 'Unique ID assigned by Emerald for this event. Can be used to order events. Event Type S Event ID will equal zero'
      - id: strategy_id
        type: u4
        doc: 'Emerald- assigned unique Complex Strategy ID for the day. Populated only for complex trades, otherwise set to zero'
      - id: reserved_12
        size: 12
        doc: 'Reserved for future use'
      - id: product_id
        type: u4
        doc: 'Option leg: Emerald Product ID mapped to a given option. It is assigned per trading session and is valid for that session. Stock leg: 0 (zero)'
      - id: underlying_symbol
        type: str
        size: 11
        encoding: ASCII
        pad-right: 0x20
        doc: 'Underlying Symbol for the option or stock leg. Format for Stock Leg: OCC Options Underlying Symbol (default) or Stock Ticker Symbol (configurable)'
      - id: underlying_type
        type: u1
        enum: underlying_type
        doc: 'Underlying Type'
      - id: security_symbol
        type: str
        size: 6
        encoding: ASCII
        pad-right: 0x20
        doc: 'Option leg: Option Security Symbol. Stock leg: Filled with spaces = N/A (Not Applicable)'
      - id: expiration_date
        type: u4
        doc: 'Option leg: Expiration date of the option in YYYYMMDD format. Stock leg: 0 (zero)'
      - id: strike_price
        type: decimal_u4_4
        doc: 'Option leg: Explicit strike price of the option. Refer to data types for field processing notes. Stock leg: 0 (zero). Implied decimal with scale 1e-4'
      - id: call_or_put
        type: u1
        enum: call_or_put
        doc: 'Option leg: Option Type'
      - id: reserved_8
        size: 8
        doc: 'Reserved for future use'
      - id: side
        type: u1
        enum: side
        doc: 'The side of the trade on which this receiver was involved in'
      - id: price
        type: decimal_u4_4
        doc: 'Trade price. In case of a corrected trade, this is the corrected trade price. Implied decimal with scale 1e-4'
      - id: size
        type: u4
        doc: 'Number of option contracts or stock shares traded in this clearing trade. In case of a corrected trade, this is the corrected trade size'
      - id: trade_condition
        type: u1
        enum: trade_condition
        doc: 'See Appendix A: Trade Conditions for list of possible values. CTD Version 1.0 will always have a Regular trade condition (= ‘ ‘ / space) for all system generated automatic trades. In case of a corrected trade, this is the corrected trade condition'
      - id: second_reserved_8
        size: 8
        doc: 'Reserved for future use'
      - id: class_fee_type
        type: u1
        enum: class_fee_type
        doc: 'Class Fee Type'
      - id: emerald_bbo_posting_increment_indicator
        type: u1
        enum: emerald_bbo_posting_increment_indicator
        doc: 'Option leg: This is the Minimum Price Variation as agreed to by the Options industry (penny pilot program) and as published by Emerald'
      - id: execution_exchange
        type: u1
        enum: execution_exchange
        doc: 'Option leg: Market where a customer option order was traded after routing from Emerald'
      - id: routed_order_quantity
        type: u4
        doc: 'This contains 0 (zero) for trades at Emerald. For trades resulting from Orders routed to other exchanges, this contains total routed quantity that will be useful in calculating away-exchange block size billing rate'
      - id: market_maker_role
        type: u1
        enum: market_maker_role
        doc: 'Pertains to this side'
      - id: traded_with_directed_mm
        type: u1
        enum: traded_with_directed_mm
        doc: 'Indicates if the trade occurred with the MM to which the order was Directed'
      - id: market_state
        type: u1
        enum: market_state
        doc: 'Simple Market State'
      - id: auction_type
        type: u1
        enum: auction_type
        doc: 'Simple Market Auction Type. Only applicable when Market State is Auction'
      - id: directed_status
        type: u1
        enum: directed_status
        doc: 'Status of directed order flow'
      - id: strategy_state
        type: u1
        enum: strategy_state
        doc: 'Strategy State'
      - id: strategy_auction_type
        type: u1
        enum: strategy_auction_type
        doc: 'Only applicable when Strategy State is Standard Auction'
      - id: stock_execution_destination
        type: u1
        enum: stock_execution_destination
        doc: 'Stock leg: Stock trading/reporting venue that will report and clear the stock leg trade'
      - id: contra_liquidity_type
        type: u1
        enum: contra_liquidity_type
        doc: 'Contra Liquidity Type'
      - id: second_reserved_12
        size: 12
        doc: 'Reserved for future use'
      - id: executing_mpid
        type: str
        size: 4
        encoding: ASCII
        pad-right: 0x20
        doc: 'For Trades due to Orders: MPID of the EEM/OFP (SenderSubID field in FIX order or FirmMPID for Emerald PRIME/cPRIME Order; Note that this will be different than Clearing MPID for MM FIX orders). For Trades due to Quotes, eQuotes: MM MPID'
      - id: order_date
        type: u4
        doc: 'For Trades due to Orders: Format: YYYYMMDD. For Trades due to Quotes, eQuotes: zero'
      - id: fix_order_id
        type: str
        size: 30
        encoding: ASCII
        pad-right: 0x20
        doc: 'For Trades due to Orders: Firm assigned Order ID sent via the CLOrderID FIX field. For Trades due to Quotes, eQuotes: Spaces'
      - id: client_message_id
        type: u4
        doc: 'For Trades due to Quotes, eQuotes: Firm assigned ID of the Quote or eQuote. For Trades due to Orders: zero'
      - id: bulk_quote_index
        type: u1
        doc: 'For Trades due to Quotes: Index assigned by Emerald to each quote in bulk quote (Index = quote position in the bulk quote). For Trades due to Orders, eQuotes: zero'
      - id: open_close_indicator
        type: u1
        enum: open_close_indicator
        doc: 'Option leg: Open/Close Indicator'
      - id: liquidity_type
        type: u1
        enum: liquidity_type
        doc: 'Pertains to this side'
      - id: mm_priority_indicator
        type: u1
        enum: mm_priority_indicator
        doc: 'Pertains to this side only if this side belongs to a market maker'
      - id: liquidity_indicator
        type: u1
        enum: liquidity_indicator
        doc: 'Pertains to this side'
      - id: liquidity_timer_role
        type: u1
        enum: liquidity_timer_role
        doc: 'When the liquidity is involved in a trade occurring in a Emerald PRIME Auction or Timer Event, this field contains the role of the liquidity'
      - id: time_in_force
        type: u1
        enum: time_in_force
        doc: 'TimeInForce'
      - id: billing_mpid
        type: str
        size: 4
        encoding: ASCII
        pad-right: 0x20
        doc: 'For Trades due to Orders: specifies the MPID that is being Billed. This defaults to the same as the Executing MPID unless an alternative MPID is specified on order entry. For Trades due to Quotes, eQuotes: MM MPID'
      - id: leg_reference_id
        type: str
        size: 5
        encoding: ASCII
        pad-right: 0x20
        doc: 'Client specified ID in FIX complex order for the leg corresponding to the option in this trade'
      - id: strategy_timer_role
        type: u1
        enum: strategy_timer_role
        doc: 'When the liquidity is involved in a trade occurring in a Complex Standard Auction as defined in field Strategy Auction Type, or a cPRIME auction or cC2C or cQCC crossing, this field contains the role of the liquidity'
      - id: stock_short_sell_indicator
        type: u1
        enum: stock_short_sell_indicator
        doc: 'Stock Short Sell indicator'
      - id: reserved_4
        size: 4
        doc: 'Reserved for future use'
      - id: clearing_mpid
        type: str
        size: 4
        encoding: ASCII
        pad-right: 0x20
        doc: 'Option leg: Clearing MPID of the member. Stock leg: Underlying MPID or the DTC Account number'
      - id: member_type
        type: u1
        enum: member_type
        doc: 'Member Type'
      - id: origin
        type: u1
        enum: origin
        doc: 'Origin'
      - id: clearing_number
        type: u4
        doc: 'Option leg: OCC Clearing number. Stock leg: 0 (zero)'
      - id: cmta
        type: u4
        doc: 'Option leg: CMTA in case of a give-up trade. Stock leg: 0 (zero)'
      - id: multi_account
        type: str
        size: 5
        encoding: ASCII
        pad-right: 0x20
        doc: 'Sub or multi account ID specified in FIX order'
      - id: account_id
        type: str
        size: 10
        encoding: ASCII
        pad-right: 0x20
        doc: 'Account ID that is supplied in the FIX order'
      - id: supplementary_id
        type: str
        size: 13
        encoding: ASCII
        pad-right: 0x20
        doc: 'Supplementary ID supplied in the Text field of the FIX order'
      - id: allocation_id
        type: str
        size: 4
        encoding: ASCII
        pad-right: 0x20
        doc: 'Individual Allocation ID (Tag 467) for each Emerald PRIME/cPRIME Order participant supplied in the FIX New Order Cross. If not applicable, filled with spaces'
      - id: billing_clearing_number
        type: u4
        doc: 'OCC Clearing number to be billed. This defaults to the same as the Clearing Number unless an alternative Billing MPID is specified on order entry. For Trades due to Quotes, eQuotes: MM Clearing Number'
      - id: order_capacity
        type: u1
        enum: order_capacity
        doc: 'Order Capacity'
      - id: reserved_7
        size: 7
        doc: 'Reserved for future use'
      - id: mpid
        type: str
        size: 4
        encoding: ASCII
        pad-right: 0x20
        doc: 'Contra side: Option leg: MPID of the member. Stock leg: Underlying MPID or the DTC Account number'
      - id: contra_member_type
        type: u1
        enum: contra_member_type
        doc: 'Member Type'
      - id: contra_origin
        type: u1
        enum: contra_origin
        doc: 'Origin'
      - id: contra_clearing_number
        type: u4
        doc: 'Option leg: OCC Clearing number. Stock leg: 0 (zero)'
      - id: contra_cmta
        type: u4
        doc: 'Option leg: CMTA in case of a give-up trade. Stock leg: 0 (zero)'
      - id: contra_time_in_force
        type: u1
        enum: contra_time_in_force
        doc: 'ContraTimeInForce'
      - id: contra_liquidity_timer_role
        type: u1
        enum: contra_liquidity_timer_role
        doc: 'When the liquidity is involved in a trade occurring in a Emerald PRIME Auction or Timer Event, this field contains the role of the contra liquidity'
      - id: contra_strategy_timer_role
        type: u1
        enum: contra_strategy_timer_role
        doc: 'When the liquidity is involved in a trade occurring in a Complex Standard Auction as defined in field Strategy Auction Type, or a cPRIME auction or cC2C or cQCC crossing, this field contains the role of the liquidity'
      - id: contra_order_capacity
        type: u1
        enum: contra_order_capacity
        doc: 'Order Capacity'
      - id: third_reserved_12
        size: 12
        doc: 'Reserved for future use'
  risk_notification_message:
    seq:
      - id: processing_time
        type: nanosecond_timestamp
        doc: 'Time at which Emerald system (Matching Engine) processed this trade. Nanoseconds since Midnight epoch'
      - id: mpid_group_id
        type: str
        size: 32
        encoding: ASCII
        pad-right: 0x20
        doc: 'Firm Assigned Group ID'
      - id: metric_id
        type: str
        size: 32
        encoding: ASCII
        pad-right: 0x20
        doc: 'Metric ID for the group'
      - id: route_id
        type: str
        size: 32
        encoding: ASCII
        pad-right: 0x20
        doc: 'ID used to route to this session'
      - id: metric_type
        type: u1
        enum: metric_type
        doc: 'Metric Type'
      - id: protection_type
        type: u1
        enum: protection_type
        doc: 'Protection Type'
      - id: event_type
        type: u1
        enum: event_type
        doc: 'Event Type'
      - id: event_id
        type: u4
        doc: 'Unique ID assigned by Emerald for this event. Can be used to order events. Event Type S Event ID will equal zero'
      - id: configured_counting_time_period
        type: u4
        doc: 'Configured time period in milliseconds which is used to consider events for this Metric ID'
      - id: configured_max_quantity
        type: u4
        doc: 'Configured max threshold of counted items for the Configured Counting Time interval for this Metric ID. Defines rate for the counting time period'
      - id: current_quantity
        type: u4
        doc: 'Current counted quantity at the time of the event for this Metric ID'
      - id: max_peak_quantity
        type: u4
        doc: 'Max peak for Current Quantity during pulse interval'
      - id: percentage_level
        type: u1
        doc: 'Current Percentage for the Counted Quantity in relationship to Configured Max Quantity. Valid values from 0 to 255%. Actual percentages greater than 255 will be reported as the max (255)'
      - id: reserved_32
        size: 32
        doc: 'Reserved for future use'
  unsequenced_data_packet:
    seq:
      - id: unsequenced_message_type
        type: u1
        enum: unsequenced_message_type
        doc: 'Message type of the application message the unsequenced data packet carries'
      - id: unsequenced_message
        size: _parent.sesm_packet_header.sesm_packet_length - 1 - 1
        type:
          switch-on: unsequenced_message_type
          cases:
            'unsequenced_message_type::risk_notification_message': risk_notification_message
  login_request:
    seq:
      - id: sesm_version
        type: str
        size: 5
        encoding: ASCII
        pad-right: 0x20
        doc: '1.1 (right padded with spaces)'
      - id: username
        type: str
        size: 5
        encoding: ASCII
        pad-right: 0x20
        doc: 'Username issued by MIAX during initial setup'
      - id: computer_id
        type: str
        size: 8
        encoding: ASCII
        pad-right: 0x20
        doc: 'ID issued by MIAX during initial setup'
      - id: application_protocol
        type: str
        size: 8
        encoding: ASCII
        pad-right: 0x20
        doc: 'Eg: MEI1.0 (right padded with spaces)'
      - id: requested_session
        type: u1
        doc: 'Specifies the session the client would like to log into, or zero to log into the currently active session'
      - id: requested_sequence_number
        type: u8
        doc: 'Specifies client requested sequence number: next sequence number the client wants to receive upon connection, or 0 to start receiving only new messages without any replay of old messages'
  login_response:
    seq:
      - id: login_status
        type: u1
        enum: login_status
        doc: 'Login Status'
      - id: session_id
        type: u1
        doc: 'The session ID of the session that is now logged into'
      - id: highest_sequence_number
        type: u8
        doc: 'The highest sequence number that the server currently has for the client'
  retransmission_request:
    seq:
      - id: start_sequence_number
        type: u8
        doc: 'Sequence number of the first packet to be retransmitted'
      - id: end_sequence_number
        type: u8
        doc: 'Sequence number of the last packet to be retransmitted'
  logout_request:
    seq:
      - id: logout_reason
        type: u1
        enum: logout_reason
        doc: 'Reason'
      - id: logout_text
        type: str
        size: _parent.sesm_packet_header.sesm_packet_length - 2
        encoding: ASCII
        doc: 'Free form human readable text to provide more details beyond the reasons mentioned above'
  goodbye_packet:
    seq:
      - id: goodbye_reason
        type: u1
        enum: goodbye_reason
        doc: 'Reason'
      - id: logout_text
        type: str
        size: _parent.sesm_packet_header.sesm_packet_length - 2
        encoding: ASCII
        doc: 'Free form human readable text to provide more details beyond the reasons mentioned above'
  test_packet:
    seq:
      - id: test_text
        type: str
        size: _parent.sesm_packet_header.sesm_packet_length - 1
        encoding: ASCII
        doc: 'Free form human readable text'
  nanosecond_timestamp:
    seq:
      - id: time
        type: s8
    instances:
      hour:
        value: time / 3600000000000 % 24
      minute:
        value: time / 60000000000 % 60
      second:
        value: time / 1000000000 % 60
      millisecond:
        value: time / 1000000 % 1000
  decimal_u4_4:
    seq:
      - id: mantissa
        type: u4
    instances:
      real:
        value: mantissa / 10000.0

enums:
  sesm_packet_type:
    0x53:
      id: 'sequenced_data_packet'
      doc: 'Sequenced data packet'
    0x55:
      id: 'unsequenced_data_packet'
      doc: 'Unsequenced data packet'
    0x4c:
      id: 'login_request'
      doc: 'Login request packet'
    0x52:
      id: 'login_response'
      doc: 'Login response packet'
    0x43:
      id: 'synchronization_complete'
      doc: 'Synchronization complete packet'
    0x41:
      id: 'retransmission_request'
      doc: 'Retransmission request packet'
    0x58:
      id: 'logout_request'
      doc: 'Logout request packet'
    0x47:
      id: 'goodbye_packet'
      doc: 'GoodBye packet'
    0x45:
      id: 'end_of_session'
      doc: 'End of Session packet'
    0x30:
      id: 'server_heartbeat'
      doc: 'Server Heartbeat packet'
    0x31:
      id: 'client_heartbeat'
      doc: 'Client Heartbeat packet'
    0x54:
      id: 'test_packet'
      doc: 'Test packet'
  sequenced_message_type:
    0x53:
      id: 'system_state'
      doc: 'This message format is used to notify firms of the state changes of the system. Firms can use notifications as triggers in their system to ensure electronic synchronization of systems.'
    0x54:
      id: 'trade_message'
      doc: 'This is the message format that will be used to disseminate all Emerald trade-related content for entitled parties. Emerald sends trades, trade corrections and trade cancels using this message. This is a sequenced message.'
    0x52:
      id: 'risk_notification_message'
      doc: 'Firms configured to use Risk Protection Monitoring will receive User Notification communicating the status of Risk checks. Field Event Type is used to determine the reason for the notification. The following message will be used to disseminate all Emerald Risk Protection Monitor (RPM) related notifications. Sequenced and UnSequenced Pkt based on Event Type: solicited event types (T, R, W, D, A, P, U) are Sequenced messages at the SesM protocol level and recoverable; unsolicited (S) are Unsequenced and not recoverable.'
  system_status:
    0x43:
      id: 'end_of_application_messages'
      doc: 'End Of Application Messages'
    0x31:
      id: 'start_of_test_session'
      doc: 'Start of Test Session (sent before tests).'
    0x32:
      id: 'end_of_test_session'
      doc: 'End Of Test Session'
  trade_action:
    0x4e:
      id: 'new_trade'
      doc: 'New Trade'
    0x43:
      id: 'trade_correction'
      doc: 'Trade Correction'
    0x58:
      id: 'trade_cancel'
      doc: 'Trade Cancel'
  trade_type:
    0x41:
      id: 'automatic'
      doc: 'Automatic execution by the system'
    0x4d:
      id: 'manual'
      doc: 'Manual trade that Traders requested Emerald personnel to enter'
  correction_type:
    0x31:
      id: 'not_applicable'
