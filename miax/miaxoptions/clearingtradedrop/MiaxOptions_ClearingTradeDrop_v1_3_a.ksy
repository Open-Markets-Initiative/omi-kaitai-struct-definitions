#
# Open Markets Initiative website:
#   https://openmarketsinitiative.com
# ---------------------------------------------------------------------

meta:
  id: miax_miaxoptions_clearingtradedrop_ctd_v1_3_a
  title: Miax MiaxOptions ClearingTradeDrop Ctd v1.3.a
  license: MIT-0
  endian: le

doc: 'Miami International Holdings MIAX Options Clearing Trade Drop Ctd v1.3.a'
doc-ref: https://www.miaxglobal.com/markets/us-options/miax-options/interface-specifications

seq:
  - id: sesm_tcp_packet
    type: sesm_tcp_packet_struct
    repeat: eos
    doc: 'SesM Tcp Packet'

types:
  sesm_tcp_packet_struct:
    seq:
      - id: sesm_packet_header
        type: sesm_packet_header
        doc: 'SesM packet header'
      - id: sesm_payload
        size: sesm_packet_header.sesm_packet_length + 2 - 3
        type:
          switch-on: sesm_packet_header.sesm_packet_type
          cases:
            'sesm_packet_type::sequenced_data_packet': sequenced_data_packet
            'sesm_packet_type::unsequenced_data_packet': unsequenced_data_packet
            'sesm_packet_type::login_request': login_request
            'sesm_packet_type::login_response': login_response
            'sesm_packet_type::retransmission_request': retransmission_request
            'sesm_packet_type::logout_request': logout_request
            'sesm_packet_type::goodbye_packet': goodbye_packet
            'sesm_packet_type::test_packet': test_packet
  sesm_packet_header:
    seq:
      - id: sesm_packet_length
        type: u2
        doc: 'The length of rest of the packet'
      - id: sesm_packet_type
        type: u1
        enum: sesm_packet_type
        doc: 'SesM protocol packet type'
  sequenced_data_packet:
    seq:
      - id: sequence_number
        type: u8
        doc: 'Sequence number of this sequenced data packet'
      - id: sequenced_message_type
        type: u1
        enum: sequenced_message_type
        doc: 'Message type of the application message the sequenced data packet carries'
      - id: sequenced_message
        size: _parent.sesm_packet_header.sesm_packet_length - 1 - 9
        type:
          switch-on: sequenced_message_type
          cases:
            'sequenced_message_type::system_state': system_state
            'sequenced_message_type::trade_message': trade_message
  system_state:
    seq:
      - id: notification_time
        type: nanosecond_timestamp
        doc: 'Time at which this was generated by MIAX system. Nanoseconds since Midnight epoch'
      - id: ctd_version
        type: str
        size: 8
        encoding: ASCII
        pad-right: 0x20
        doc: 'Eg: CTD01.02'
      - id: trading_session_id
        type: u4
        doc: 'MIAX assigned ID for the current trading session. A change in Session ID will mean that restarting at message sequence number 1'
      - id: system_status
        type: u1
        enum: system_status
        doc: 'Current system status'
  trade_message:
    seq:
      - id: processing_time
        type: nanosecond_timestamp
        doc: 'Time at which MIAX system (Matching Engine) processed this trade. Nanoseconds since Midnight epoch'
      - id: trade_time
        type: nanosecond_timestamp
        doc: 'Automatic Trades: Time at which the Matching Engine created this trade. Will be same as Processing Time. Manual Trades: Trade Time of the new manual trade. Trades cancels, corrections: Trade Time of the original trade. Nanoseconds since Midnight epoch'
      - id: trade_as_of_date
        type: u4
        doc: 'As-of Date for As-of Trades. Format: YYYYMMDD. Zero for non As-of Trades'
      - id: trade_action
        type: u1
        enum: trade_action
        doc: 'Note that New trades and Trade Cancel messages can also be generated due to a Clearing changing correction. See Correction Type field for details'
      - id: trade_type
        type: u1
        enum: trade_type
        doc: 'Trade Type'
      - id: trade_id
        type: u4
        doc: 'MIAX assigned unique Trade ID for the day. For corrections and cancels, this is the trade ID of the original trade. When used in conjunction with Correction Number, this is a unique identifier for each clearing trade'
      - id: execution_id
        type: u8
        doc: 'MIAX assigned unique Execution ID. Each side of the Clearing trade will have a unique Execution ID'
      - id: correction_number
        type: u1
        doc: 'Trade correction number. Used to identify version of the trade being corrected or canceled. Increments by 1 for each subsequent correction. While this is 0 for new trades, new trades resulting from corrections may have a non-zero number'
      - id: transaction_id
        type: u4
        doc: 'All clearing trades generated from a single Engine transaction will have the same transaction ID'
      - id: reference_trade_time
        type: nanosecond_timestamp
        doc: 'Time of the parent trade (version of this trade that was active prior to this correction) in case of a correction or a new trade generated due to correction. 0 otherwise. Nanoseconds since Midnight epoch'
      - id: reference_trade_id
        type: u4
        doc: 'Trade ID of the parent trade in case of a correction or a new trade generated due to correction. 0 otherwise'
      - id: reference_correction_number
        type: u1
        doc: 'Correction Number of the parent trade in case of a correction or a new trade generated due to correction. 0 otherwise'
      - id: correction_type
        type: u1
        enum: correction_type
        doc: 'Gives more information to the user when this is a correction'
      - id: event_id
        type: u4
        doc: 'Event ID in case this trade is a result of a liquidity gathering event at MIAX. 0 otherwise. Please refer to the TransactionType field for the Event type associated with this Event ID'
      - id: reserved_16
        size: 16
        doc: 'Reserved for future use'
      - id: product_id
        type: u4
        doc: 'MIAX Product ID mapped to a given option. It is assigned per trading session and is valid for that session'
      - id: underlying_symbol
        type: str
        size: 11
        encoding: ASCII
        pad-right: 0x20
        doc: 'Stock Symbol for the option'
      - id: underlying_type
        type: u1
        enum: underlying_type
        doc: 'Underlying Type'
      - id: security_symbol
        type: str
        size: 6
        encoding: ASCII
        pad-right: 0x20
        doc: 'Option Security Symbol'
      - id: expiration_date
        type: u4
        doc: 'Expiration date of the option in YYYYMMDD format'
      - id: strike_price
        type: decimal_u4_4
        doc: 'Explicit strike price of the option. Refer to data types for field processing notes. Implied decimal with scale 1e-4'
      - id: call_or_put
        type: u1
        enum: call_or_put
        doc: 'Option Type'
      - id: reserved_8
        size: 8
        doc: 'Reserved for future use'
      - id: side
        type: u1
        enum: side
        doc: 'The side of the trade on which this receiver was involved in'
      - id: price
        type: decimal_u4_4
        doc: 'Trade price. This is the corrected trade price if that price changed in a trade correction. Implied decimal with scale 1e-4'
      - id: size
        type: u4
        doc: 'Number of contract traded in this clearing trade. This is the corrected trade size if that size changed in a trade correction'
      - id: trade_condition
        type: u1
        enum: trade_condition
        doc: 'See Appendix A for list of possible values. This is the corrected trade condition if that condition changed in a trade correction'
      - id: second_reserved_8
        size: 8
        doc: 'Reserved for future use'
      - id: class_fee_type
        type: u1
        enum: class_fee_type
        doc: 'Class Fee Type'
      - id: miax_bbo_posting_increment_indicator
        type: u1
        enum: miax_bbo_posting_increment_indicator
        doc: 'This is the Minimum Price Variation as agreed to by the Options industry (penny pilot program) and as published by MIAX'
      - id: execution_exchange
        type: u1
        enum: execution_exchange
        doc: 'Market where a customer order was traded after routing from MIAX'
      - id: routed_order_quantity
        type: u4
        doc: 'This contains 0 (zero) for trades at MIAX. For trades resulting from Orders routed to other exchanges, this contains total routed quantity that will be useful in calculating away-exchange block size billing rate'
      - id: market_maker_role
        type: u1
        enum: market_maker_role
        doc: 'Pertains to this side'
      - id: traded_with_directed_mm
        type: u1
        enum: traded_with_directed_mm
        doc: 'Indicates if the trade occurred with the MM to which the order was Directed'
      - id: market_state
        type: u1
        enum: market_state
        doc: 'Market State'
      - id: auction_type
        type: u1
        enum: auction_type
        doc: 'Auction Type'
      - id: directed_status
        type: u1
        enum: directed_status
        doc: 'Directed Status'
      - id: second_reserved_16
        size: 16
        doc: 'Reserved for future use'
      - id: executing_mpid
        type: str
        size: 4
        encoding: ASCII
        pad-right: 0x20
        doc: 'For Trades due to Orders: MPID of the EEM/OFP (SenderSubID field in FIX order; Note that this will be different than Clearing MPID for MM FIX orders). For Trades due to Quotes, eQuotes: MM MPID'
      - id: order_date
        type: u4
        doc: 'For Trades due to Orders: Format: YYYYMMDD. For Trades due to Quotes, eQuotes: zero'
      - id: fix_order_id
        type: str
        size: 30
        encoding: ASCII
        pad-right: 0x20
        doc: 'For Trades due to Orders: Firm assigned Order ID sent via the CLOrderID FIX field. For Trades due to Quotes, eQuotes: Spaces'
      - id: client_message_id
        type: u4
        doc: 'For Trades due to Quotes, eQuotes: Firm assigned ID of the Quote or eQuote. For Trades due to Orders: zero'
      - id: bulk_quote_index
        type: u1
        doc: 'For Trades due to Quotes: Index assigned by MIAX to each quote in bulk quote (Index = quote position in the bulk quote). For Trades due to Orders, eQuotes: zero'
      - id: open_close_indicator
        type: u1
        enum: open_close_indicator
        doc: 'Open/Close Indicator'
      - id: liquidity_type
        type: u1
        enum: liquidity_type
        doc: 'Pertains to this side'
      - id: mm_priority_indicator
        type: u1
        enum: mm_priority_indicator
        doc: 'Pertains to this side only if this side belongs to a market maker'
      - id: liquidity_indicator
        type: u1
        enum: liquidity_indicator
        doc: 'Pertains to this side'
      - id: liquidity_timer_role
        type: u1
        enum: liquidity_timer_role
        doc: 'When the liquidity is involved in a trade that occurred in an auction/timer event, this field contains the role of the liquidity in that timer'
      - id: third_reserved_16
        size: 16
        doc: 'Reserved for future use'
      - id: mpid
        type: str
        size: 4
        encoding: ASCII
        pad-right: 0x20
        doc: 'MPID of the member'
      - id: member_type
        type: u1
        enum: member_type
        doc: 'Member Type'
      - id: origin
        type: u1
        enum: origin
        doc: 'Origin'
      - id: clearing_number
        type: u4
        doc: 'OCC Clearing number'
      - id: cmta
        type: u4
        doc: 'CMTA in case of a give-up trade'
      - id: multi_account
        type: str
        size: 5
        encoding: ASCII
        pad-right: 0x20
        doc: 'Sub or multi account ID specified in FIX order'
      - id: account_id
        type: str
        size: 10
        encoding: ASCII
        pad-right: 0x20
        doc: 'Account ID that is supplied in the FIX order'
      - id: supplementary_id
        type: str
        size: 13
        encoding: ASCII
        pad-right: 0x20
        doc: 'Supplementary ID supplied in the Text field of the FIX order'
      - id: fourth_reserved_16
        size: 16
        doc: 'Reserved for future use'
      - id: contra_mpid
        type: str
        size: 4
        encoding: ASCII
        pad-right: 0x20
        doc: 'MPID of the member'
      - id: contra_member_type
        type: u1
        enum: contra_member_type
        doc: 'Member Type'
      - id: contra_origin
        type: u1
        enum: contra_origin
        doc: 'Origin'
      - id: contra_clearing_number
        type: u4
        doc: 'OCC Clearing number'
      - id: contra_cmta
        type: u4
        doc: 'CMTA in case of a give-up trade'
      - id: fifth_reserved_16
        size: 16
        doc: 'Reserved for future use'
  unsequenced_data_packet:
    seq:
      - id: unsequenced_message_type
        type: str
        size: 1
        encoding: ASCII
        doc: 'Message type of the application message the unsequenced data packet carries'
  login_request:
    seq:
      - id: sesm_version
        type: str
        size: 5
        encoding: ASCII
        pad-right: 0x20
        doc: '1.0 (right padded with spaces)'
      - id: username
        type: str
        size: 5
        encoding: ASCII
        pad-right: 0x20
        doc: 'Username issued by MIAX during initial setup'
      - id: computer_id
        type: str
        size: 8
        encoding: ASCII
        pad-right: 0x20
        doc: 'ID issued by MIAX during initial setup'
      - id: application_protocol
        type: str
        size: 8
        encoding: ASCII
        pad-right: 0x20
        doc: 'Eg: MEI1.0 (right padded with spaces)'
      - id: requested_session
        type: u1
        doc: 'Specifies the session the client would like to log into, or zero to log into the currently active session'
      - id: requested_sequence_number
        type: u8
        doc: 'Specifies client requested sequence number: next sequence number the client wants to receive upon connection, or 0 to start receiving only new messages without any replay of old messages'
  login_response:
    seq:
      - id: login_status
        type: u1
        enum: login_status
        doc: 'Login Status'
      - id: session_id
        type: u1
        doc: 'The session ID of the session that is now logged into'
      - id: highest_sequence_number
        type: u8
        doc: 'The highest sequence number that the server currently has for the client'
  retransmission_request:
    seq:
      - id: start_sequence_number
        type: u8
        doc: 'Sequence number of the first packet to be retransmitted'
      - id: end_sequence_number
        type: u8
        doc: 'Sequence number of the last packet to be retransmitted'
  logout_request:
    seq:
      - id: logout_reason
        type: u1
        enum: logout_reason
        doc: 'Reason'
      - id: logout_text
        type: str
        size: _parent.sesm_packet_header.sesm_packet_length - 2
        encoding: ASCII
        doc: 'Free form human readable text to provide more details beyond the reasons mentioned above'
  goodbye_packet:
    seq:
      - id: goodbye_reason
        type: u1
        enum: goodbye_reason
        doc: 'Reason'
      - id: logout_text
        type: str
        size: _parent.sesm_packet_header.sesm_packet_length - 2
        encoding: ASCII
        doc: 'Free form human readable text to provide more details beyond the reasons mentioned above'
  test_packet:
    seq:
      - id: test_text
        type: str
        size: _parent.sesm_packet_header.sesm_packet_length - 1
        encoding: ASCII
        doc: 'Free form human readable text'
  nanosecond_timestamp:
    seq:
      - id: time
        type: s8
    instances:
      hour:
        value: time / 3600000000000 % 24
      minute:
        value: time / 60000000000 % 60
      second:
        value: time / 1000000000 % 60
      millisecond:
        value: time / 1000000 % 1000
  decimal_u4_4:
    seq:
      - id: mantissa
        type: u4
    instances:
      real:
        value: mantissa / 10000.0

enums:
  sesm_packet_type:
    0x53:
      id: 'sequenced_data_packet'
      doc: 'Sequenced data packet'
    0x55:
      id: 'unsequenced_data_packet'
      doc: 'Unsequenced data packet'
    0x4c:
      id: 'login_request'
      doc: 'Login request packet'
    0x52:
      id: 'login_response'
      doc: 'Login response packet'
    0x43:
      id: 'synchronization_complete'
      doc: 'Synchronization complete packet'
    0x41:
      id: 'retransmission_request'
      doc: 'Retransmission request packet'
    0x58:
      id: 'logout_request'
      doc: 'Logout request packet'
    0x47:
      id: 'goodbye_packet'
      doc: 'GoodBye packet'
    0x45:
      id: 'end_of_session'
      doc: 'End of Session packet'
    0x30:
      id: 'server_heartbeat'
      doc: 'Server Heartbeat packet'
    0x31:
      id: 'client_heartbeat'
      doc: 'Client Heartbeat packet'
    0x54:
      id: 'test_packet'
      doc: 'Test packet'
  sequenced_message_type:
    0x53:
      id: 'system_state'
      doc: 'This message format is used to notify firms of the state changes of the system. Firms can use notifications as triggers in their system to ensure electronic synchronization of systems.'
    0x54:
      id: 'trade_message'
      doc: 'This is the message format that will be used to disseminate all MIAX trade related content for entitled parties. MIAX sends trades, trade corrections and trade cancels using this message. This is a sequenced message.'
  system_status:
    0x43:
      id: 'end_of_application_messages'
      doc: 'End Of Application Messages'
    0x31:
      id: 'start_of_test_session'
      doc: 'Start of Test Session (sent before tests).'
    0x32:
      id: 'end_of_test_session'
      doc: 'End Of Test Session'
  trade_action:
    0x4e:
      id: 'new_trade'
      doc: 'New Trade'
    0x43:
      id: 'trade_correction'
      doc: 'Trade Correction'
    0x58:
      id: 'trade_cancel'
      doc: 'Trade Cancel'
  trade_type:
    0x41:
      id: 'automatic'
      doc: 'Automatic execution by the system'
    0x4d:
      id: 'manual'
      doc: 'Manual trade that Traders requested MIAX personnel to enter'
  correction_type:
    0x31:
      id: 'not_applicable'
      doc: 'Not Applicable (Used when message is generated due to a transaction other than Trade corrections)'
    0x32:
      id: 'price_andor_size_change'
      doc: 'Price Andor Size Change'
    0x33:
      id: 'this_side_clearing_change'
      doc: 'This side Clearing change (Could affect size for Trade splits)'
    0x34:
      id: 'contra_side_clearing_change'
      doc: 'Contra Side Clearing Change'
    0x35:
      id: 'both_side_clearing_change'
      doc: 'Both Side Clearing Change'
  underlying_type:
    0x46:
      id: 'etf'
      doc: 'Etf'
    0x49:
      id: 'index'
      doc: 'Index'
    0x45:
      id: 'equity'
      doc: 'Equity'
  call_or_put:
    0x43:
      id: 'call'
      doc: 'Call'
    0x50:
      id: 'put'
      doc: 'Put'
  side:
    0x42:
      id: 'buy'
      doc: 'Buy'
    0x53:
      id: 'sell'
      doc: 'Sell'
  trade_condition:
    0x20:
      id: 'regular'
      doc: 'Space = Regular'
    0x41:
      id: 'cancel_of_trade_previously_reported_other_than_as_the_last_or_opening'
      doc: 'Cancel of Trade previously reported other than as the last or opening for the particular Option'
    0x42:
      id: 'late_and_is_out_of_sequence'
      doc: 'Trade that is Late and is out of sequence'
    0x43:
      id: 'cancel_of_the_last_reported_trade'
      doc: 'Cancel of the last reported Trade for the particular Option'
    0x44:
      id: 'late_and_is_in_correct_sequence'
      doc: 'Trade that is Late and is in correct sequence'
    0x45:
      id: 'cancel_of_the_first_reported_trade'
      doc: 'Cancel of the first (opening) reported Trade for the particular Option'
    0x46:
      id: 'late_report_of_the_opening_trade_and_is_out_of_sequence'
      doc: 'Trade that is late report of the opening trade and is out of sequence'
    0x47:
      id: 'cancel_of_the_only_reported_trade'
      doc: 'Cancel of the only reported Trade for the particular Option'
    0x48:
      id: 'late_report_of_the_opening_trade_and_is_in_correct_sequence'
      doc: 'Trade that is late report of the opening trade and is in correct sequence'
    0x49:
      id: 'reserved'
      doc: 'Reserved for future use'
    0x4a:
      id: 'reopening_of_an_option'
      doc: 'Trade due to reopening of an Option in which trading has been previously halted; process as a regular transaction.'
    0x4b:
      id: 'reserved_x4b'
      doc: 'Reserved for future use'
    0x4c:
      id: 'reserved_x4c'
      doc: 'Reserved for future use'
    0x4d:
      id: 'reserved_x4d'
      doc: 'Reserved for future use'
    0x4e:
      id: 'reserved_x4e'
      doc: 'Reserved for future use'
    0x4f:
      id: 'reserved_x4f'
      doc: 'Reserved for future use'
    0x50:
      id: 'reserved_x50'
      doc: 'Reserved for future use'
    0x51:
      id: 'reserved_x51'
      doc: 'Reserved for future use'
    0x52:
      id: 'execution_of_a_stopped_order'
      doc: 'Trade was the execution of an order which was “stopped” at a price that did not constitute a Trade-Through on another market at the time of the stop. Process like a normal transaction except don’t update “last”.'
    0x53:
      id: 'execution_of_an_iso_order'
      doc: 'Trade was the execution of an order identified as an Intermarket Sweep Order (ISO).'
    0x54:
      id: 'reserved_x54'
      doc: 'Reserved for future use'
    0x58:
      id: 'trade_through_exempt'
      doc: 'Trade that is Trade Through Exempt. The trade should be treated like a regular sale.'
  class_fee_type:
    0x43:
      id: 'conventional_fee_based'
      doc: 'Conventional Fee Based'
    0x4d:
      id: 'maker_taker_fee_based'
      doc: 'Maker Taker Fee Based'
  miax_bbo_posting_increment_indicator:
    0x50:
      id: 'penny'
      doc: 'Price <= $3: Penny (0.01); Price > $3: Penny (0.01)'
    0x4e:
      id: 'penny_nickel'
      doc: 'Price <= $3: Penny (0.01); Price > $3: Nickel (0.05)'
    0x44:
      id: 'nickel_dime'
      doc: 'Price <= $3: Nickel (0.05); Price > $3: Dime (0.10)'
  execution_exchange:
    0x41:
      id: 'nyse_amex'
      doc: 'Nyse Amex'
    0x4e:
      id: 'nyse_arca'
      doc: 'Nyse Arca'
    0x42:
      id: 'box_field'
      doc: 'Box'
    0x43:
      id: 'cboe'
      doc: 'Cboe'
    0x57:
      id: 'c_2'
      doc: 'C2 (from CBOE)'
    0x49:
      id: 'ise'
      doc: 'Ise'
    0x48:
      id: 'ise_topaz'
      doc: 'Ise Topaz'
    0x51:
      id: 'nasdaq_omx_options_market'
      doc: 'Nasdaq Omx Options Market'
    0x58:
      id: 'nasdaq_omx_phlx_options_market'
      doc: 'Nasdaq Omx Phlx Options Market'
    0x54:
      id: 'nasdaq_bx'
      doc: 'Nasdaq Bx'
    0x5a:
      id: 'bats'
      doc: 'Bats'
    0x20:
      id: 'traded_at_miax'
      doc: '‘ ‘ (space) = Traded at MIAX'
  market_maker_role:
    0x50:
      id: 'plmm'
      doc: 'Plmm'
    0x4c:
      id: 'lmm'
      doc: 'Lmm'
    0x52:
      id: 'rmm'
      doc: 'Rmm'
    0x55:
      id: 'umm'
      doc: 'UMM (Unassigned MM for this Underlying)'
    0x20:
      id: 'other'
      doc: '‘ ‘ (space) = other'
