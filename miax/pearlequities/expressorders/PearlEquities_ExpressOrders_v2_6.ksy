        doc: 'Trade correction number'
      - id: trade_status
        type: u1
        enum: trade_status
        doc: 'Possible values:'
      - id: last_price
        type: decimal_u8_6
        doc: 'Match price if the order had not been prevented. Implied decimal with scale 1e-6'
      - id: last_size
        type: u4
        doc: 'Number of shares that would have matched if the'
