        size: 12
        doc: 'Reserved for future use'
  order_execution_instructions:
    meta:
      bit-endian: le
    seq:
      - id: side
        type: b1
        doc: 'Side'
      - id: unused_15
        type: b15
        doc: 'Reserved for future use'
  additional_liquidity_indicator:
    meta:
      bit-endian: le
    seq:
      - id: nbbo_setter_joiner
        type: b3
        doc: 'NBBO Setter/Joiner/First Joiner'
      - id: unused_5
        type: b5
        doc: 'Reserved for future use'
  unsequenced_data_packet:
    seq:
      - id: unsequenced_message_type
        type: str
        size: 2
        encoding: ASCII
        doc: 'ESesM unsequenced message type'
      - id: unsequenced_message
        size: _parent.esesm_packet_header.esesm_packet_length - 3 - 2
        type:
          switch-on: unsequenced_message_type
          cases:
            '"N1"': new_order_request_message
            '"NR"': new_order_response_message
            '"M1"': modify_order_request_message
            '"MR"': modify_order_response
            '"CO"': cancel_order_request
            '"CR"': cancel_order_response
            '"CX"': cancel_order_by_exchange_order_id_request
            '"CQ"': cancel_order_by_exchange_order_id_response_message
            '"XQ"': mass_cancel_request
            '"XR"': mass_cancel_response
            '"RA"': reserve_order_replenishment_notification
            '"E1"': execution_notification
  new_order_request_message:
    seq:
      - id: reserved_8
        size: 8
        doc: 'Reserved for future use'
      - id: mpid
        type: str
        size: 4
        encoding: ASCII
        pad-right: 0x20
        doc: 'Four character NSCC MPID of the Firm'
      - id: client_order_id
        type: str
        size: 20
        encoding: ASCII
        doc: 'Firm specified unique order Id'
      - id: symbol_id
        type: u4
        doc: 'Symbol ID mapped to a given symbol'
      - id: price
        type: decimal_u8_6
        doc: 'Limit price of the order. Implied decimal with scale 1e-6'
      - id: size
        type: u4
        doc: 'Number of shares to buy/sell'
      - id: new_order_instructions
        type: new_order_instructions
        doc: 'New Order Instructions'
      - id: time_in_force
        type: u1
        enum: time_in_force
        doc: 'Time in Force'
      - id: order_type
        type: u1
        enum: order_type
        doc: 'Order Type'
      - id: price_sliding_and_reprice_frequency
        type: u1
        enum: price_sliding_and_reprice_frequency
        doc: 'Price Sliding and Reprice Frequency'
      - id: self_trade_protection
        type: self_trade_protection
        doc: 'Self Trade Protection'
      - id: self_trade_protection_group
        type: str
        size: 1
        encoding: ASCII
        pad-right: 0x20
        doc: 'Customer specified protection group'
      - id: routing
        type: routing
        doc: 'Routing Flags'
      - id: trading_collar_dollar_value
        type: decimal_s8_6
        doc: 'Market Order Custom Dollar Value Trading Collar Protection. Implied decimal with scale 1e-6'
      - id: capacity
        type: u1
        enum: capacity
        doc: 'Capacity'
      - id: account
        type: str
        size: 16
        encoding: ASCII
        doc: 'Optional customer ID provided by the Firm'
      - id: clearing_account
        type: str
        size: 4
        encoding: ASCII
        doc: 'Optional supplemental order identifier'
      - id: min_qty
        type: u4
        doc: 'Minimum fill quantity'
      - id: max_floor_qty
        type: u4
        doc: 'Number of shares of the order to display'
      - id: display_range_qty
        type: u4
        doc: 'Used for random replenishment of Reserve orders'
      - id: peg_offset
        type: decimal_s8_6
        doc: 'Signed dollar value up to four decimal places for a pegged order. Implied decimal with scale 1e-6'
      - id: locate_account
        type: str
        size: 4
        encoding: ASCII
        doc: 'Optional information provided by Firm for Sell'
      - id: purge_group
        type: str
        size: 1
        encoding: ASCII
        pad-right: 0x20
        doc: 'Customer specified purge group'
      - id: reserved_19
        size: 19
        doc: 'Reserved for future use'
  modify_order_request_message:
    seq:
      - id: reserved_8
        size: 8
        doc: 'Reserved for future use'
      - id: mpid
        type: str
        size: 4
        encoding: ASCII
        pad-right: 0x20
        doc: 'Four character NSCC MPID of the Firm'
      - id: client_order_id
        type: str
        size: 20
        encoding: ASCII
        doc: 'Firm specified unique order Id'
      - id: original_client_order_id
        type: str
        size: 20
        encoding: ASCII
        doc: 'Target Client Order ID that is being modified'
      - id: symbol_id
        type: u4
        doc: 'Symbol ID mapped to a given symbol'
      - id: price
        type: decimal_u8_6
        doc: 'Limit price of the order. Implied decimal with scale 1e-6'
      - id: size
        type: u4
        doc: 'Number of shares to buy/sell'
      - id: modify_order_instructions
        type: modify_order_instructions
        doc: 'Modify Order Instructions'
      - id: min_qty
        type: u4
        doc: 'Minimum fill quantity'
      - id: max_floor_qty
        type: u4
        doc: 'Number of shares of the order to display'
      - id: locate_account
        type: str
        size: 4
        encoding: ASCII
        doc: 'Optional information provided by Firm for Sell'
      - id: reserved_28
        size: 28
        doc: 'Reserved for future use'
  cancel_order_request:
    seq:
      - id: reserved_8
        size: 8
        doc: 'Reserved for future use'
      - id: mpid
        type: str
        size: 4
        encoding: ASCII
        pad-right: 0x20
        doc: 'Four character NSCC MPID of the Firm'
      - id: client_order_id
        type: str
        size: 20
        encoding: ASCII
        doc: 'Firm specified unique order Id'
      - id: original_client_order_id
        type: str
        size: 20
        encoding: ASCII
        doc: 'Target Client Order ID that is being modified'
      - id: symbol_id
        type: u4
        doc: 'Symbol ID mapped to a given symbol'
      - id: reserved_10
        size: 10
        doc: 'Reserved for future use'
  cancel_order_by_exchange_order_id_request:
    seq:
      - id: reserved_8
        size: 8
        doc: 'Reserved for future use'
      - id: mpid
        type: str
        size: 4
        encoding: ASCII
        pad-right: 0x20
        doc: 'Four character NSCC MPID of the Firm'
      - id: client_order_id
        type: str
        size: 20
        encoding: ASCII
        doc: 'Firm specified unique order Id'
      - id: order_id
        type: u8
        doc: 'Exchanged assigned unique order ID when order is accepted'
      - id: symbol_id
        type: u4
        doc: 'Symbol ID mapped to a given symbol'
      - id: reserved_10
        size: 10
        doc: 'Reserved for future use'
  mass_cancel_request:
    seq:
      - id: reserved_8
        size: 8
        doc: 'Reserved for future use'
      - id: mpid
        type: str
        size: 4
        encoding: ASCII
        pad-right: 0x20
        doc: 'Four character NSCC MPID of the Firm'
      - id: client_order_id
        type: str
        size: 20
        encoding: ASCII
        doc: 'Firm specified unique order Id'
      - id: scope
        type: u1
        enum: scope
        doc: 'Scope'
      - id: action
        type: u1
        enum: action
        doc: '‘B’ – Block only The system will reject all new'
      - id: purge_group
        type: str
        size: 1
        encoding: ASCII
        pad-right: 0x20
        doc: 'Customer specified purge group'
      - id: reserved_9
        size: 9
        doc: 'Reserved for future use'
  mass_cancel_response:
    seq:
      - id: notification_time
        type: nanosecond_timestamp
        doc: 'Time at which this message was generated by the. Nanoseconds since Unix epoch'
      - id: mpid
        type: str
        size: 4
        encoding: ASCII
        pad-right: 0x20
        doc: 'Four character NSCC MPID of the Firm'
      - id: client_order_id
        type: str
        size: 20
        encoding: ASCII
        doc: 'Firm specified unique order Id'
      - id: number_of_matching_engines
        type: u1
        doc: '24 This is the number of Matching Engines in'
      - id: matching_engine_status
        type: str
        size: 24
        encoding: ASCII
        pad-right: 0x20
        doc: 'Status response for the Mass Cancel Request from'
      - id: reserved_10
        size: 10
        doc: 'Reserved for future use'
  login_request:
    seq:
      - id: esesm_version
        type: str
        size: 5
        encoding: ASCII
        pad-right: 0x20
        doc: 'Protocol version'
      - id: username
        type: str
        size: 5
        encoding: ASCII
        pad-right: 0x20
        doc: 'issued by MIAX during initial setup'
      - id: computer_id
        type: str
        size: 8
        encoding: ASCII
        pad-right: 0x20
        doc: 'issued by MIAX Futures Exchange during initial setup'
      - id: application_protocol
        type: str
        size: 8
        encoding: ASCII
        pad-right: 0x20
        doc: 'Miax Application Protocol'
      - id: requested_trading_session_id
        type: u1
        doc: 'Specifies the session the client would like to log into, or zero to log into the currently active session'
      - id: requested_sequence_number
        type: u8
        doc: 'Specifies client requested sequence number'
  login_response:
    seq:
      - id: number_of_matching_engines
        type: u1
        doc: '24 This is the number of Matching Engines in'
      - id: login_status
        type: u1
        enum: login_status
        doc: 'Login Status'
      - id: trading_session_id
        type: u1
        doc: 'The current trading session ID of the corresponding Matching Engine'
      - id: highest_sequence_number
        type: u8
        doc: 'the highest sequence number that the server currently has for the client'
  synchronization_complete:
    seq:
      - id: number_of_matching_engines
        type: u1
        doc: '24 This is the number of Matching Engines in'
  retransmission_request:
    seq:
      - id: start_sequence_number
        type: u8
        doc: 'Sequence number of the first packet to be retransmitted'
      - id: end_sequence_number
        type: u8
        doc: 'Sequence number of the last packet to be retransmitted'
  logout_request:
    seq:
      - id: logout_reason
        type: u1
        enum: logout_reason
        doc: 'Logout Request Reason'
      - id: logout_text
        type: str
        size: _parent.esesm_packet_header.esesm_packet_length - 2
        encoding: ASCII
        doc: 'Free form human readable text'
  goodbye_packet:
    seq:
      - id: logout_reason
        type: u1
        enum: logout_reason
        doc: 'Logout Request Reason'
      - id: logout_text
        type: str
        size: _parent.esesm_packet_header.esesm_packet_length - 2
        encoding: ASCII
        doc: 'Free form human readable text'
  test_packet:
    seq:
      - id: test_text
        type: str
        size: _parent.esesm_packet_header.esesm_packet_length - 1
        encoding: ASCII
        doc: 'Free form human readable text'
  nanosecond_timestamp:
    seq:
      - id: time
        type: s8
    instances:
      hour:
        value: time / 3600000000000 % 24
      minute:
        value: time / 60000000000 % 60
      second:
        value: time / 1000000000 % 60
      millisecond:
        value: time / 1000000 % 1000
  decimal_u8_6:
    seq:
      - id: mantissa
        type: u8
    instances:
      real:
        value: mantissa / 1000000.0
  decimal_s8_6:
    seq:
      - id: mantissa
        type: s8
    instances:
      real:
        value: mantissa / 1000000.0

