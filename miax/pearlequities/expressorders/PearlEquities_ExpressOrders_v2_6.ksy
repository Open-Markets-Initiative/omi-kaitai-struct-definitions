      - id: symbol_id
        type: u4
        doc: 'Symbol ID mapped to a given symbol'
      - id: order_id
        type: u8
        doc: 'Exchanged assigned unique order ID when order is accepted'
      - id: secondary_order_id
        type: u8
        doc: 'Secondary Order ID used to publish the display'
      - id: display_qty
        type: u4
        doc: 'Display size of the Reserve order after replenishment'
      - id: reserved_10
        size: 10
        doc: 'Reserved for future use'
  execution_notification:
    seq:
      - id: matching_engine_time
        type: nanosecond_timestamp
        doc: 'Time at which this message was generated by the Matching Engine. Nanoseconds since Unix epoch'
      - id: mpid
        type: str
        size: 4
        encoding: ASCII
        pad-right: 0x20
        doc: 'Four character NSCC MPID of the Firm'
      - id: symbol_id
        type: u4
        doc: 'Symbol ID mapped to a given symbol'
      - id: client_order_id
        type: str
        size: 20
        encoding: ASCII
        doc: 'Firm specified unique order Id'
      - id: trade_id
