        type: nanosecond_timestamp
        doc: 'Time at which this message was generated by the Matching Engine. Nanoseconds since Unix epoch'
      - id: symbol_id
        type: u4
        doc: 'Symbol ID mapped to a given symbol'
      - id: order_id
        type: u8
        doc: 'Exchanged assigned unique order ID when order is accepted'
      - id: working_price
        type: decimal_u8_6
        doc: 'Current Working Price of the order. Implied decimal with scale 1e-6'
      - id: nbbo_indicator
        type: u1
        enum: nbbo_indicator
        doc: 'NBBO Indicator'
      - id: reserved_9
        size: 9
        doc: 'Reserved for future use'
  reserve_order_replenishment_notification:
