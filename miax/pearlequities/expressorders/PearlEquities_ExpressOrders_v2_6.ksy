        size: 20
        encoding: ASCII
        doc: 'Firm specified unique order Id'
      - id: symbol_id
        type: u4
        doc: 'Symbol ID mapped to a given symbol'
      - id: order_id
        type: u8
        doc: 'Exchanged assigned unique order ID when order is accepted'
      - id: leaves_qty
        type: u4
        doc: 'Size of the order that is still open, includes size on'
      - id: cancel_reason
