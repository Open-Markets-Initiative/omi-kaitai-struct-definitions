meta:
  id: miax_pearlequities_expressorders_meo_v2_6
  title: Miax PearlEquities ExpressOrders Meo v2.6
  license: GPL-3.0
  endian: le

doc: 'Miami International Holdings MIAX Pearl Equities Express Orders Meo v2.6'
doc-ref: https://www.miaxglobal.com/markets/us-equities/pearl-equities/interface-specifications

seq:
  - id: esesm_tcp_packet
    type: esesm_tcp_packet_struct
    repeat: eos
    doc: 'ESesM Tcp Packet'

types:
  esesm_tcp_packet_struct:
    seq:
      - id: esesm_packet_header
        type: esesm_packet_header
        doc: 'ESesM packet header'
      - id: esesm_payload
        size: esesm_packet_header.esesm_packet_length + 2 - 3
        type:
          switch-on: esesm_packet_header.esesm_packet_type
          cases:
            'esesm_packet_type::sequenced_data_packet': sequenced_data_packet
            'esesm_packet_type::unsequenced_data_packet': unsequenced_data_packet
            'esesm_packet_type::login_request': login_request
            'esesm_packet_type::login_response': login_response
            'esesm_packet_type::synchronization_complete': synchronization_complete
            'esesm_packet_type::retransmission_request': retransmission_request
            'esesm_packet_type::logout_request': logout_request
            'esesm_packet_type::goodbye_packet': goodbye_packet
            'esesm_packet_type::test_packet': test_packet
  esesm_packet_header:
    seq:
      - id: esesm_packet_length
        type: u2
        doc: 'The length of rest of the packet'
      - id: esesm_packet_type
        type: u1
        enum: esesm_packet_type
        doc: 'ESesM protocol packet type'
  sequenced_data_packet:
    seq:
      - id: sequence_number
        type: u8
        doc: 'Sequence number of this sequenced data packet'
      - id: matching_engine_id
        type: u1
        doc: 'Matching Engine that originated the packet'
      - id: sequenced_message_type
        type: str
        size: 2
        encoding: ASCII
        doc: 'ESesM sequenced message type'
      - id: sequenced_message
        size: _parent.esesm_packet_header.esesm_packet_length - 12 - 11
        type:
          switch-on: sequenced_message_type
          cases:
            '"SU"': symbol_update
            '"NR"': new_order_response_message
            '"MR"': modify_order_response
            '"CR"': cancel_order_response
            '"CQ"': cancel_order_by_exchange_order_id_response_message
            '"SN"': system_state_notification
            '"O1"': new_order_notification
            '"MN"': modify_order_notification
            '"XN"': cancel_reduce_size_order_notification
            '"PU"': order_price_update_notification
            '"RA"': reserve_order_replenishment_notification
            '"E1"': execution_notification
  symbol_update:
    seq:
      - id: matching_engine_time
        type: nanosecond_timestamp
        doc: 'Time at which this message was generated by the Matching Engine. Nanoseconds since Unix epoch'
      - id: symbol_id
        type: u4
        doc: 'Symbol ID mapped to a given symbol'
      - id: ticker_symbol
        type: str
        size: 11
        encoding: ASCII
        pad-right: 0x20
        doc: 'Ticker symbol for the security in NASDAQ'
      - id: reserved_1
        size: 1
        doc: 'Reserved for future use'
      - id: test_security_indicator
        type: u1
        enum: test_security_indicator
        doc: 'Test Security Indicator'
      - id: future
        type: u1
        doc: 'Reserved for future use'
      - id: lot_size
        type: u4
        doc: 'Round Lot size in shares'
      - id: opening_time
        type: str
        size: 8
        encoding: ASCII
        pad-right: 0x20
        doc: 'Expressed in HH:MM:SS format Eg:'
      - id: closing_time
        type: str
        size: 8
        encoding: ASCII
        pad-right: 0x20
        doc: 'Expressed in HH:MM:SS format Eg:'
      - id: primary_market_code
        type: u1
        enum: primary_market_code
        doc: 'Primary Market Code'
      - id: reserved_12
        size: 12
        doc: 'Reserved for future use'
  new_order_response_message:
    seq:
      - id: matching_engine_time
        type: nanosecond_timestamp
        doc: 'Time at which this message was generated by the Matching Engine. Nanoseconds since Unix epoch'
      - id: mpid
        type: str
        size: 4
        encoding: ASCII
        pad-right: 0x20
        doc: 'Four character NSCC MPID of the Firm'
      - id: client_order_id
        type: str
        size: 20
        encoding: ASCII
        doc: 'Firm specified unique order Id'
      - id: symbol_id
        type: u4
        doc: 'Symbol ID mapped to a given symbol'
      - id: order_id
        type: u8
        doc: 'Exchanged assigned unique order ID when order is accepted'
      - id: price
        type: decimal_u8_6
        doc: 'Limit price of the order. Implied decimal with scale 1e-6'
      - id: size
        type: u4
        doc: 'Number of shares to buy/sell'
      - id: order_status
        type: u1
        enum: order_status
        doc: 'Order Status'
      - id: reserved_19
        size: 19
        doc: 'Reserved for future use'
  modify_order_response:
    seq:
      - id: matching_engine_time
        type: nanosecond_timestamp
        doc: 'Time at which this message was generated by the Matching Engine. Nanoseconds since Unix epoch'
      - id: mpid
        type: str
        size: 4
        encoding: ASCII
        pad-right: 0x20
        doc: 'Four character NSCC MPID of the Firm'
      - id: client_order_id
        type: str
        size: 20
        encoding: ASCII
        doc: 'Firm specified unique order Id'
      - id: original_client_order_id
        type: str
        size: 20
        encoding: ASCII
        doc: 'Target Client Order ID that is being modified'
      - id: symbol_id
        type: u4
        doc: 'Symbol ID mapped to a given symbol'
      - id: order_id
        type: u8
        doc: 'Exchanged assigned unique order ID when order is accepted'
      - id: leaves_qty
        type: u4
        doc: 'Size of the order that is still open, includes size on'
      - id: price
        type: decimal_u8_6
        doc: 'Limit price of the order. Implied decimal with scale 1e-6'
      - id: modify_status
        type: u1
        enum: modify_status
        doc: 'Modify Status'
      - id: reserved_10
        size: 10
        doc: 'Reserved for future use'
  cancel_order_response:
    seq:
      - id: matching_engine_time
        type: nanosecond_timestamp
        doc: 'Time at which this message was generated by the Matching Engine. Nanoseconds since Unix epoch'
      - id: mpid
        type: str
        size: 4
        encoding: ASCII
        pad-right: 0x20
        doc: 'Four character NSCC MPID of the Firm'
      - id: client_order_id
        type: str
        size: 20
        encoding: ASCII
        doc: 'Firm specified unique order Id'
      - id: original_client_order_id
        type: str
        size: 20
        encoding: ASCII
        doc: 'Target Client Order ID that is being modified'
      - id: symbol_id
        type: u4
        doc: 'Symbol ID mapped to a given symbol'
      - id: order_id
        type: u8
        doc: 'Exchanged assigned unique order ID when order is accepted'
      - id: leaves_qty
        type: u4
        doc: 'Size of the order that is still open, includes size on'
      - id: cancel_status
        type: u1
        enum: cancel_status
        doc: 'Cancel Status'
      - id: reserved_10
        size: 10
        doc: 'Reserved for future use'
  cancel_order_by_exchange_order_id_response_message:
    seq:
      - id: matching_engine_time
        type: nanosecond_timestamp
        doc: 'Time at which this message was generated by the Matching Engine. Nanoseconds since Unix epoch'
      - id: mpid
        type: str
        size: 4
        encoding: ASCII
        pad-right: 0x20
        doc: 'Four character NSCC MPID of the Firm'
      - id: client_order_id
        type: str
        size: 20
        encoding: ASCII
        doc: 'Firm specified unique order Id'
      - id: symbol_id
        type: u4
        doc: 'Symbol ID mapped to a given symbol'
      - id: order_id
        type: u8
        doc: 'Exchanged assigned unique order ID when order is accepted'
      - id: leaves_qty
        type: u4
        doc: 'Size of the order that is still open, includes size on'
      - id: cancel_status
        type: u1
        enum: cancel_status
        doc: 'Cancel Status'
      - id: reserved_10
        size: 10
        doc: 'Reserved for future use'
  system_state_notification:
    seq:
      - id: matching_engine_time
        type: nanosecond_timestamp
        doc: 'Time at which this message was generated by the Matching Engine. Nanoseconds since Unix epoch'
      - id: meo_version
        type: str
        size: 8
        encoding: ASCII
        pad-right: 0x20
        doc: 'MEO interface version Eg: MEO1 0'
      - id: session_id
        type: u1
        doc: 'MIAX Pearl Equities assigned ID for the current'
      - id: system_status
        type: u1
        enum: system_status
        doc: 'System Status'
      - id: reserved_8
        size: 8
        doc: 'Reserved for future use'
  new_order_notification:
    seq:
      - id: matching_engine_time
        type: nanosecond_timestamp
        doc: 'Time at which this message was generated by the Matching Engine. Nanoseconds since Unix epoch'
      - id: mpid
        type: str
        size: 4
        encoding: ASCII
        pad-right: 0x20
        doc: 'Four character NSCC MPID of the Firm'
      - id: order_id
        type: u8
        doc: 'Exchanged assigned unique order ID when order is accepted'
      - id: client_order_id
        type: str
        size: 20
        encoding: ASCII
        doc: 'Firm specified unique order Id'
      - id: symbol_id
        type: u4
        doc: 'Symbol ID mapped to a given symbol'
      - id: price
        type: decimal_u8_6
        doc: 'Limit price of the order. Implied decimal with scale 1e-6'
      - id: size
        type: u4
        doc: 'Number of shares to buy/sell'
      - id: new_order_instructions
        type: new_order_instructions
        doc: 'New Order Instructions'
      - id: time_in_force
        type: u1
        enum: time_in_force
        doc: 'Time in Force'
      - id: order_type
        type: u1
        enum: order_type
        doc: 'Order Type'
      - id: price_sliding_and_reprice_frequency
        type: u1
        enum: price_sliding_and_reprice_frequency
        doc: 'Price Sliding and Reprice Frequency'
      - id: self_trade_protection
        type: self_trade_protection
        doc: 'Self Trade Protection'
      - id: self_trade_protection_group
        type: str
        size: 1
        encoding: ASCII
        pad-right: 0x20
        doc: 'Customer specified protection group'
      - id: routing
        type: routing
        doc: 'Routing Flags'
      - id: trading_collar_dollar_value
        type: decimal_s8_6
        doc: 'Market Order Custom Dollar Value Trading Collar Protection. Implied decimal with scale 1e-6'
      - id: capacity
        type: u1
        enum: capacity
        doc: 'Capacity'
      - id: account
        type: str
        size: 16
        encoding: ASCII
        doc: 'Optional customer ID provided by the Firm'
      - id: clearing_account
        type: str
        size: 4
        encoding: ASCII
        doc: 'Optional supplemental order identifier'
      - id: min_qty
        type: u4
        doc: 'Minimum fill quantity'
      - id: max_floor_qty
        type: u4
        doc: 'Number of shares of the order to display'
      - id: display_range_qty
        type: u4
        doc: 'Used for random replenishment of Reserve orders'
      - id: peg_offset
        type: decimal_s8_6
        doc: 'Signed dollar value up to four decimal places for a pegged order. Implied decimal with scale 1e-6'
      - id: locate_account
        type: str
        size: 4
        encoding: ASCII
        doc: 'Optional information provided by Firm for Sell'
      - id: purge_group
        type: str
        size: 1
        encoding: ASCII
        pad-right: 0x20
        doc: 'Customer specified purge group'
      - id: original_order_capacity
        type: u1
        enum: original_order_capacity
        doc: 'As specified in the New Order Request'
      - id: reserved_18
        size: 18
        doc: 'Reserved for future use'
  new_order_instructions:
    meta:
      bit-endian: le
    seq:
      - id: side
        type: b1
        doc: 'Side'
      - id: short_sale_indicator
        type: b2
        doc: 'Short Sale Indicator'
      - id: displayed
        type: b1
        doc: 'Displayed'
      - id: post_only
        type: b1
        doc: 'PostOnly'
      - id: locate_required
        type: b1
        doc: 'Locate Required'
      - id: iso
        type: b1
        doc: 'ISO'
      - id: retail_order
        type: b1
        doc: 'Retail Order'
      - id: attributable_order
        type: b2
        doc: 'Attributable Order'
      - id: min_qty_exec_type
        type: b2
        doc: 'Attributable Order'
      - id: cancel_order_if_not_a_nbbo_setter
        type: b1
        doc: 'Cancel Order if NOT a NBBO Setter'
      - id: unused_3
        type: b3
        doc: 'Reserved for future use'
  self_trade_protection:
    meta:
      bit-endian: le
    seq:
      - id: self_trade_protection_level
        type: b3
        doc: 'Self Trade Protection Level'
      - id: self_trade_protection_instruction
        type: b3
        doc: 'Self Trade Protection Instruction'
      - id: unused_2
        type: b2
        doc: 'Reserved for future use'
  routing:
    meta:
      bit-endian: le
    seq:
      - id: routing_instruction
        type: b3
        doc: 'Routing Instruction'
      - id: routing_strategy
        type: b3
        doc: 'Routing Strategy'
      - id: unused_2
        type: b2
        doc: 'Reserved for future use'
  modify_order_notification:
    seq:
      - id: matching_engine_time
        type: nanosecond_timestamp
        doc: 'Time at which this message was generated by the Matching Engine. Nanoseconds since Unix epoch'
      - id: mpid
        type: str
        size: 4
        encoding: ASCII
        pad-right: 0x20
        doc: 'Four character NSCC MPID of the Firm'
      - id: client_order_id
        type: str
        size: 20
        encoding: ASCII
        doc: 'Firm specified unique order Id'
      - id: original_client_order_id
        type: str
        size: 20
        encoding: ASCII
        doc: 'Target Client Order ID that is being modified'
      - id: symbol_id
        type: u4
        doc: 'Symbol ID mapped to a given symbol'
      - id: order_id
        type: u8
        doc: 'Exchanged assigned unique order ID when order is accepted'
      - id: price
        type: decimal_u8_6
        doc: 'Limit price of the order. Implied decimal with scale 1e-6'
      - id: size
        type: u4
        doc: 'Number of shares to buy/sell'
      - id: leaves_qty
        type: u4
        doc: 'Size of the order that is still open, includes size on'
      - id: modify_order_instructions
        type: modify_order_instructions
        doc: 'Modify Order Instructions'
      - id: min_qty
        type: u4
        doc: 'Minimum fill quantity'
      - id: max_floor_qty
        type: u4
        doc: 'Number of shares of the order to display'
      - id: pending_modify_status
        type: u1
        enum: pending_modify_status
        doc: 'Modification request status'
      - id: pending_reject_reason
        type: u1
        enum: pending_reject_reason
        doc: 'Pending replace reject reason'
      - id: locate_account
        type: str
        size: 4
        encoding: ASCII
        doc: 'Optional information provided by Firm for Sell'
      - id: reserved_26
        size: 26
        doc: 'Reserved for future use'
  modify_order_instructions:
